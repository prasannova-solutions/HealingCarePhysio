---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0D9488" />
		
		<!-- SEO Meta Tags -->
		<title>Healing Care Physio & Matrix Gym | Premier Physiotherapy & Rehabilitation Clinic</title>
		<meta name="description" content="Healing Care Physio in Gadhinglaj provides advanced physiotherapy, sports injury rehabilitation, stroke recovery, 24/7 residential hospital stays, and medical fitness." />
		<meta name="keywords" content="physiotherapy, Gadhinglaj, sports rehab, stroke rehabilitation, residential physiotherapy hospital, Matrix Physio Gym, Dr Vrishabh Kasar, Dr Tejaswini Kasar" />
		<meta name="author" content="Healing Care Physio" />

		<!-- OpenGraph / Social Sharing -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Healing Care Physio | Expert Physiotherapy & Rehabilitation Center" />
		<meta property="og:description" content="Move better. Feel stronger. Live without limits. Specialized care for spine, joint, neuro rehab, and residential hospital stays." />
		<meta property="og:image" content="/bothCutout.png" />
		
		<!-- Fonts Preconnect -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	</head>
	<body class="bg-white text-slate-800 antialiased selection:bg-teal-100 selection:text-teal-900 overflow-x-hidden">
		<Navbar />
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
