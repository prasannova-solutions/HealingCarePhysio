<!-- =========================================================
     TRUST / CREDIBILITY SECTION
========================================================= -->
<section
    class="relative w-full overflow-hidden border-y border-slate-200/70 bg-gradient-to-b from-white via-slate-50/80 to-white py-5 sm:py-7"
>
    <!-- Decorative background -->
    <div
        class="pointer-events-none absolute -left-20 top-1/2 h-40 w-40 -translate-y-1/2 rounded-full bg-teal-100/30 blur-3xl"
    >
    </div>

    <div
        class="pointer-events-none absolute -right-20 top-1/2 h-40 w-40 -translate-y-1/2 rounded-full bg-cyan-100/30 blur-3xl"
    >
    </div>

    <div class="relative mx-auto w-full max-w-5xl px-3 sm:px-6">
        <!-- =====================================================
             TRUST HEADING
        ====================================================== -->
        <div class="mb-5 sm:mb-7 flex items-center justify-center">
            <!-- Left line -->
            <div
                class="hidden h-px flex-1 max-w-32 bg-gradient-to-r from-transparent to-teal-300 sm:block"
            >
            </div>

            <!-- Center -->
            <div class="flex items-center gap-2.5 sm:gap-4 sm:px-5">
                <!-- Shield -->
                <div
                    class="relative flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-teal-200 bg-teal-50 shadow-[0_4px_15px_rgba(13,148,136,0.10)] sm:h-10 sm:w-10"
                >
                    <!-- Glow -->
                    <div
                        class="absolute inset-0 rounded-full bg-teal-400/10 blur-md"
                    >
                    </div>

                    <svg
                        class="relative h-4 w-4 text-teal-600 sm:h-5 sm:w-5"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        aria-hidden="true"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zm3.707 6.764a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                            clip-rule="evenodd"></path>
                    </svg>
                </div>

                <!-- Heading -->
                <div class="text-center">
                    <h3
                        class="text-[15px] font-extrabold tracking-tight text-slate-900 sm:text-xl md:text-2xl"
                    >
                        5+ Years of <space></space>
                        <span class="relative inline-block text-teal-600">
                            Trusted Care

                            <!-- Curved underline -->
                            <svg
                                class="absolute -bottom-1 left-0 h-2.5 w-full overflow-visible sm:-bottom-2 sm:h-3"
                                viewBox="0 0 100 12"
                                fill="none"
                                aria-hidden="true"
                            >
                                <path
                                    d="M2 8.5C24 2 76 2 98 8.5"
                                    stroke="currentColor"
                                    stroke-width="2.8"
                                    stroke-linecap="round"></path>
                            </svg>
                        </span>
                        <span class="text-slate-900"> in Gadhinglaj </span>
                    </h3>
                </div>
            </div>

            <!-- Right line -->
            <div
                class="hidden h-px flex-1 max-w-32 bg-gradient-to-l from-transparent to-teal-300 sm:block"
            >
            </div>
        </div>

        <!-- =====================================================
     TRUST CARDS — SOFT AESTHETIC COLOR VERSION
====================================================== -->
        <div class="grid grid-cols-4 gap-2.5 sm:gap-4">
            <!-- =================================================
         CARD 1 — TEAL
    ================================================== -->
            <div
                class="group relative isolate overflow-hidden rounded-2xl border border-teal-100/80 bg-gradient-to-br from-white via-teal-50/80 to-teal-100/70 p-2.5 text-center shadow-[0_8px_25px_rgba(13,148,136,0.07)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_15px_35px_rgba(13,148,136,0.14)] sm:p-4"
            >
                <!-- Decorative blobs -->
                <div
                    class="absolute -right-7 -top-7 -z-10 h-20 w-20 rounded-full bg-teal-300/20 blur-2xl transition-transform duration-500 group-hover:scale-150"
                >
                </div>

                <div
                    class="absolute -bottom-8 -left-8 -z-10 h-20 w-20 rounded-full bg-cyan-200/20 blur-2xl"
                >
                </div>

                <!-- Icon -->
                <div
                    class="relative mx-auto mb-2 flex h-8 w-8 items-center justify-center rounded-xl bg-white/80 p-1.5 shadow-sm ring-1 ring-teal-100 backdrop-blur-sm transition-transform duration-300 group-hover:scale-110 sm:h-11 sm:w-11 sm:p-2"
                >
                    <img
                        src="/Calender.png"
                        alt="Years of care"
                        class="h-full w-full object-contain"
                    />
                </div>

                <!-- Number -->
                <div
                    class="text-sm font-extrabold tracking-tight text-slate-900 sm:text-xl"
                >
                    5+
                </div>

                <!-- Label -->
                <div
                    class="mt-0.5 text-[8px] font-semibold uppercase tracking-wide text-teal-700/70 sm:text-[10px]"
                >
                    Years Care
                </div>

                <!-- Bottom accent -->
                <div
                    class="mx-auto mt-2 h-1 w-6 rounded-full bg-teal-400/60 transition-all duration-300 group-hover:w-10"
                >
                </div>
            </div>

            <!-- =================================================
         CARD 2 — CYAN
    ================================================== -->
            <div
                class="group relative isolate overflow-hidden rounded-2xl border border-cyan-100/80 bg-gradient-to-br from-white via-cyan-50/80 to-sky-100/70 p-2.5 text-center shadow-[0_8px_25px_rgba(6,182,212,0.07)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_15px_35px_rgba(6,182,212,0.14)] sm:p-4"
            >
                <!-- Decorative blobs -->
                <div
                    class="absolute -right-7 -top-7 -z-10 h-20 w-20 rounded-full bg-cyan-300/20 blur-2xl transition-transform duration-500 group-hover:scale-150"
                >
                </div>

                <div
                    class="absolute -bottom-8 -left-8 -z-10 h-20 w-20 rounded-full bg-sky-200/25 blur-2xl"
                >
                </div>

                <!-- Icon -->
                <div
                    class="relative mx-auto mb-2 flex h-8 w-8 items-center justify-center rounded-xl bg-white/80 p-1.5 shadow-sm ring-1 ring-cyan-100 backdrop-blur-sm transition-transform duration-300 group-hover:scale-110 sm:h-11 sm:w-11 sm:p-2"
                >
                    <img
                        src="/people.png"
                        alt="Patients treated"
                        class="h-full w-full object-contain"
                    />
                </div>

                <!-- Number -->
                <div
                    class="text-sm font-extrabold tracking-tight text-slate-900 sm:text-xl"
                >
                    10k+
                </div>

                <!-- Label -->
                <div
                    class="mt-0.5 text-[8px] font-semibold uppercase tracking-wide text-cyan-700/70 sm:text-[10px]"
                >
                    Patients
                </div>

                <!-- Bottom accent -->
                <div
                    class="mx-auto mt-2 h-1 w-6 rounded-full bg-cyan-400/60 transition-all duration-300 group-hover:w-10"
                >
                </div>
            </div>

            <!-- =================================================
         CARD 3 — EMERALD
    ================================================== -->
            <div
                class="group relative isolate overflow-hidden rounded-2xl border border-emerald-100/80 bg-gradient-to-br from-white via-emerald-50/80 to-teal-100/70 p-2.5 text-center shadow-[0_8px_25px_rgba(16,185,129,0.07)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_15px_35px_rgba(16,185,129,0.14)] sm:p-4"
            >
                <!-- Decorative blobs -->
                <div
                    class="absolute -right-7 -top-7 -z-10 h-20 w-20 rounded-full bg-emerald-300/20 blur-2xl transition-transform duration-500 group-hover:scale-150"
                >
                </div>

                <div
                    class="absolute -bottom-8 -left-8 -z-10 h-20 w-20 rounded-full bg-teal-200/25 blur-2xl"
                >
                </div>

                <!-- Icon -->
                <div
                    class="relative mx-auto mb-2 flex h-8 w-8 items-center justify-center rounded-xl bg-white/80 p-1.5 shadow-sm ring-1 ring-emerald-100 backdrop-blur-sm transition-transform duration-300 group-hover:scale-110 sm:h-11 sm:w-11 sm:p-2"
                >
                    <img
                        src="/TetescopeandHat.png"
                        alt="Qualified physiotherapy experts"
                        class="h-full w-full object-contain"
                    />
                </div>

                <!-- Title -->
                <div
                    class="text-[11px] font-extrabold tracking-tight text-slate-900 sm:text-base"
                >
                    Qualified
                </div>

                <!-- Label -->
                <div
                    class="mt-0.5 text-[8px] font-semibold uppercase tracking-wide text-emerald-700/70 sm:text-[10px]"
                >
                    Experts
                </div>

                <!-- Bottom accent -->
                <div
                    class="mx-auto mt-2 h-1 w-6 rounded-full bg-emerald-400/60 transition-all duration-300 group-hover:w-10"
                >
                </div>
            </div>

            <!-- =================================================
         CARD 4 — SKY BLUE
    ================================================== -->
            <div
                class="group relative isolate overflow-hidden rounded-2xl border border-sky-100/80 bg-gradient-to-br from-white via-sky-50/80 to-blue-100/70 p-2.5 text-center shadow-[0_8px_25px_rgba(14,165,233,0.07)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_15px_35px_rgba(14,165,233,0.14)] sm:p-4"
            >
                <!-- Decorative blobs -->
                <div
                    class="absolute -right-7 -top-7 -z-10 h-20 w-20 rounded-full bg-sky-300/20 blur-2xl transition-transform duration-500 group-hover:scale-150"
                >
                </div>

                <div
                    class="absolute -bottom-8 -left-8 -z-10 h-20 w-20 rounded-full bg-blue-200/25 blur-2xl"
                >
                </div>

                <!-- Icon -->
                <div
                    class="relative mx-auto mb-2 flex h-8 w-8 items-center justify-center rounded-xl bg-white/80 p-1.5 shadow-sm ring-1 ring-sky-100 backdrop-blur-sm transition-transform duration-300 group-hover:scale-110 sm:h-11 sm:w-11 sm:p-2"
                >
                    <img
                        src="/OrthoNuro.png"
                        alt="Orthopedic neurological and sports physiotherapy"
                        class="h-full w-full object-contain"
                    />
                </div>

                <!-- Title -->
                <div
                    class="whitespace-nowrap text-[9px] font-extrabold tracking-tight text-slate-900 sm:text-sm"
                >
                    Ortho • Neuro
                </div>

                <!-- Label -->
                <div
                    class="mt-0.5 text-[8px] font-semibold uppercase tracking-wide text-sky-700/70 sm:text-[10px]"
                >
                    Sports
                </div>

                <!-- Bottom accent -->
                <div
                    class="mx-auto mt-2 h-1 w-6 rounded-full bg-sky-400/60 transition-all duration-300 group-hover:w-10"
                >
                </div>
            </div>
        </div>

        <!-- =====================================================
             BOTTOM MICRO TRUST LINE
        ====================================================== -->
        <div
            class="mt-4 flex items-center justify-center gap-1.5 text-[8px] font-medium text-slate-400 sm:mt-5 sm:text-[10px]"
        >
            <span class="h-1.5 w-1.5 rounded-full bg-teal-400"></span>

            <span> Patient-focused physiotherapy in Gadhinglaj </span>

            <span class="h-1.5 w-1.5 rounded-full bg-teal-400"></span>
        </div>
    </div>
</section>
