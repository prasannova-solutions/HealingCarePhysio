---
// PatientReviews.astro
const reviews = [
    {
        id: "sanghesh-sutar",
        name: "Sanghesh Sutar",
        role: "Patient Experience",
        videoSrc: "/Vedios/Reviews/SangheshSutarReview.mp4",
        thumbnail: "/Vedios/Reviews/SangesgSutarThumbnail.png",
        badge: "Patient Story",
    },
    {
        id: "sachin-kadam",
        name: "Sachin Kadam",
        role: "Patient Experience",
        videoSrc: "/Vedios/Reviews/SachinKadamReview.mp4",
        thumbnail: "/Vedios/Reviews/SachinKadamThumnail.png",
        badge: "Patient Story",
    },
    {
        id: "dattatray-kumbhar",
        name: "Dattatray Kumbhar",
        role: "Patient Experience",
        videoSrc: "/Vedios/Reviews/DattrayKumbarReview.mp4",
        thumbnail: "/Vedios/Reviews/DattrayKumbarThumbnail.png",
        badge: "Patient Story",
    },
    {
        id: "maya-mane",
        name: "Maya Mane",
        role: "Patient Experience",
        videoSrc: "/Vedios/Reviews/MayaManeReview.mp4",
        thumbnail: "/Vedios/Reviews/MayaManeThumbnail.png",
        badge: "Patient Story",
    },
    {
        id: "reshma-rahul-angad",
        name: "Reshma, Rahul & Angad",
        role: "Patient Experience",
        videoSrc: "/Vedios/Reviews/ReshmaRahulAngadReview.mp4",
        thumbnail: "/Vedios/Reviews/ReshmaRahulThumbnail.png",
        badge: "Patient Story",
    },
];
---

<!-- =========================================================
     PATIENT STORIES / VIDEO REVIEWS (OPTIMIZED FOR 60FPS SCROLL)
========================================================= -->
<section
    id="patient-stories"
    class="relative overflow-hidden bg-[#f7fbfa] py-20 sm:py-24 lg:py-32"
>
    <!-- =========================
         BACKGROUND DECORATION (GPU-Isolated)
    ========================== -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden bg-decor-layer">
        <!-- Large soft circle -->
        <div
            class="absolute -left-32 top-20 h-72 w-72 rounded-full
                   bg-teal-100/40 blur-2xl sm:h-96 sm:w-96"
        >
        </div>

        <!-- Right circle -->
        <div
            class="absolute -right-40 top-1/3 h-96 w-96 rounded-full
                   bg-cyan-100/30 blur-2xl"
        >
        </div>

        <!-- Bottom glow -->
        <div
            class="absolute bottom-0 left-1/2 h-64 w-[70%]
                   -translate-x-1/2 rounded-full
                   bg-emerald-50/70 blur-2xl"
        >
        </div>

        <!-- Decorative SVG -->
        <svg
            class="absolute right-[5%] top-16 hidden h-32 w-32 text-teal-200/50 lg:block"
            viewBox="0 0 100 100"
            fill="none"
        >
            <circle
                cx="50"
                cy="50"
                r="38"
                stroke="currentColor"
                stroke-width="1"
                stroke-dasharray="4 6"></circle>
            <circle
                cx="50"
                cy="50"
                r="24"
                stroke="currentColor"
                stroke-width="1"
                stroke-dasharray="2 5"></circle>
        </svg>
    </div>

    <!-- =========================
         CONTENT
    ========================== -->
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- HEADER -->
        <div class="mx-auto max-w-3xl text-center">
            <!-- Eyebrow matching Hero badge -->
            <div
                class="mb-5 inline-flex items-center gap-2 rounded-full
                       border border-slate-200/90 bg-white/95 px-3.5 py-1.5
                       shadow-xs backdrop-blur"
            >
                <span class="h-2 w-2 rounded-full bg-[#0D9488] ring-4 ring-teal-50"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-slate-900">
                    Patient Stories
                </span>
            </div>

            <!-- Heading -->
            <h2
                class="text-3xl font-extrabold tracking-tight text-slate-900
                       sm:text-4xl lg:text-5xl leading-tight"
            >
                Real People.
                <span class="text-[#0D9488]"> Real Recovery. </span>
            </h2>

            <!-- Description -->
            <p
                class="mx-auto mt-4 max-w-2xl text-base leading-relaxed
                       text-slate-600 sm:text-lg"
            >
                Hear directly from our patients about their experience,
                treatment journey, and the difference personalised physiotherapy
                made in their recovery.
            </p>
        </div>

        <!-- =========================
             DESKTOP CONTROLS
        ========================== -->
        <div
            class="mt-10 hidden items-center justify-between lg:flex"
        >
            <div>
                <p class="text-sm font-medium text-slate-500">
                    Patient experiences
                </p>

                <p class="mt-1 text-xs text-slate-400">
                    Swipe or use the arrows to explore
                </p>
            </div>

            <div class="flex items-center gap-3">
                <!-- Previous -->
                <button
                    id="reviewPrev"
                    type="button"
                    aria-label="Previous patient review"
                    class="group flex h-11 w-11 items-center justify-center
                           rounded-full border border-slate-200
                           bg-white text-slate-600 shadow-xs
                           transition-all duration-300
                           hover:-translate-y-0.5
                           hover:border-teal-200
                           hover:bg-teal-50
                           hover:text-teal-600 cursor-pointer"
                >
                    <svg
                        class="h-5 w-5 transition-transform group-hover:-translate-x-0.5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                    >
                        <path
                            d="M15 18l-6-6 6-6"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </svg>
                </button>

                <!-- Next -->
                <button
                    id="reviewNext"
                    type="button"
                    aria-label="Next patient review"
                    class="group flex h-11 w-11 items-center justify-center
                           rounded-full bg-teal-600 text-white shadow-lg
                           shadow-teal-600/20
                           transition-all duration-300
                           hover:-translate-y-0.5
                           hover:bg-teal-700 cursor-pointer"
                >
                    <svg
                        class="h-5 w-5 transition-transform group-hover:translate-x-0.5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                    >
                        <path
                            d="M9 18l6-6-6-6"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </svg>
                </button>
            </div>
        </div>

        <!-- =========================
             VIDEO SLIDER
        ========================== -->
        <div class="relative mt-8 sm:mt-10">
            <div
                id="reviewSlider"
                tabindex="0"
                role="region"
                aria-label="Patient review video slider"
                class="review-slider flex gap-4 overflow-x-auto
                       scroll-smooth pb-6
                       sm:gap-6 lg:gap-7
                       snap-x snap-mandatory
                       focus:outline-hidden"
            >
                {reviews.map((review, index) => (
                    <article
                        class="review-card min-w-[82vw]
                               snap-center
                               sm:min-w-[48%]
                               lg:min-w-[31.5%]
                               lg:snap-start"
                        data-index={index}
                    >
                        <div
                            class="group relative overflow-hidden rounded-[28px]
                                   border border-slate-100 bg-white
                                   shadow-[0_10px_30px_rgba(15,118,110,0.08)]
                                   transition-all duration-300
                                   hover:-translate-y-1.5
                                   hover:shadow-[0_20px_40px_rgba(15,118,110,0.12)]"
                        >
                            <!-- Video Container with Facade Overlay -->
                            <div
                                class="video-container relative aspect-[9/16] overflow-hidden bg-slate-950 cursor-pointer select-none"
                            >
                                <video
                                    class="review-video h-full w-full object-cover"
                                    src={review.videoSrc}
                                    poster={review.thumbnail}
                                    playsinline
                                    preload="none"
                                    controls
                                ></video>

                                <!-- Top Badge (Optimized with solid alpha, zero blur lag) -->
                                <div
                                    class="pointer-events-none absolute left-4 top-4 z-20
                                           rounded-full border border-white/20
                                           bg-slate-950/70 px-3 py-1.5
                                           text-[10px] font-semibold uppercase
                                           tracking-wider text-white"
                                >
                                    {review.badge}
                                </div>

                                <!-- Play Facade Button Overlay -->
                                <div
                                    class="play-overlay absolute inset-0 z-10 flex flex-col items-center justify-center
                                           bg-gradient-to-t from-black/60 via-black/20 to-transparent
                                           transition-opacity duration-300"
                                >
                                    <button
                                        type="button"
                                        aria-label={`Play review of ${review.name}`}
                                        class="play-btn flex h-16 w-16 items-center justify-center rounded-full
                                               bg-teal-500/90 text-white shadow-xl shadow-teal-900/40
                                               border border-white/30 backdrop-blur-xs
                                               transition-all duration-300 hover:scale-110 hover:bg-teal-400 cursor-pointer"
                                    >
                                        <svg
                                            class="h-7 w-7 translate-x-0.5 fill-current"
                                            viewBox="0 0 24 24"
                                        >
                                            <path d="M8 5v14l11-7z" />
                                        </svg>
                                    </button>
                                    <span class="mt-3 text-xs font-medium text-white/90 drop-shadow-sm tracking-wide">
                                        Click to watch story
                                    </span>
                                </div>
                            </div>

                            <!-- Card Footer -->
                            <div class="p-5 sm:p-6">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-sm font-semibold text-slate-900">
                                            {review.name}
                                        </p>
                                        <p class="mt-1 text-xs text-slate-500">
                                            {review.role}
                                        </p>
                                    </div>

                                    <div
                                        class="flex h-9 w-9 items-center justify-center rounded-full
                                               bg-teal-50 text-teal-600"
                                    >
                                        <svg
                                            class="h-4 w-4"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="1.8"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                                        </svg>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </article>
                ))}
            </div>

            <!-- =========================
                 MOBILE SWIPE HINT
            ========================== -->
            <div
                class="mt-3 flex items-center justify-center gap-2
                       text-xs text-slate-400 lg:hidden"
            >
                <svg
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                >
                    <path
                        d="M8 12h8M8 12l3-3M8 12l3 3"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                </svg>

                Swipe to explore patient stories

                <svg
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                >
                    <path
                        d="M16 12H8m8 0l-3-3m3 3l-3 3"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                </svg>
            </div>

            <!-- =========================
                 PROGRESS INDICATOR
            ========================== -->
            <div id="reviewDots" class="mt-7 flex justify-center gap-2"></div>
        </div>

        <!-- =========================
             BOTTOM TRUST MESSAGE
        ========================== -->
        <div class="mx-auto mt-12 max-w-2xl text-center sm:mt-16">
            <div
                class="inline-flex items-center gap-2 rounded-full
                       border border-teal-100 bg-white/90 px-4 py-2
                       shadow-xs"
            >
                <svg
                    class="h-4 w-4 text-teal-600"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                >
                    <path
                        d="M12 2l2.7 6.1L21 9l-4.5 4.3L17.7 20
                           12 16.8 6.3 20l1.2-6.7L3 9l6.3-.9L12 2z"
                    ></path>
                </svg>

                <span class="text-xs font-medium text-slate-600 sm:text-sm">
                    Trusted by patients throughout their recovery journey
                </span>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================
     PERFORMANCE-TUNED CSS
========================================================= -->
<style>
    /* Background decorator container hardware isolation */
    .bg-decor-layer {
        contain: strict;
        transform: translateZ(0);
    }

    /* Hide scrollbar but keep native horizontal scrolling */
    .review-slider {
        scrollbar-width: none;
        -ms-overflow-style: none;
        overscroll-behavior-x: contain;
        -webkit-overflow-scrolling: touch;
        transform: translateZ(0);
        will-change: scroll-position;
    }

    .review-slider::-webkit-scrollbar {
        display: none;
    }

    /* Content containment to avoid heavy layout thrashing during scroll */
    .review-card {
        contain: layout style paint;
        transform: translateZ(0);
    }

    /* Better mobile snap behaviour */
    @media (max-width: 1023px) {
        .review-slider {
            scroll-padding-left: 9vw;
            scroll-padding-right: 9vw;
        }
    }

    /* Desktop cards transition */
    @media (min-width: 1024px) {
        .review-card {
            transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        }
    }

    /* State when video is playing: hide overlay */
    .video-container.is-playing .play-overlay {
        opacity: 0;
        pointer-events: none;
    }
</style>

<!-- =========================================================
     PERFORMANCE-OPTIMIZED SLIDER & VIDEO SCRIPT
========================================================= -->
<script>
    function setupReviewSlider() {
        const slider = document.getElementById("reviewSlider");
        if (!slider) return;

        const cards = [...slider.querySelectorAll(".review-card")];
        const containers = [...slider.querySelectorAll(".video-container")];
        const prevButton = document.getElementById("reviewPrev");
        const nextButton = document.getElementById("reviewNext");
        const dotsContainer = document.getElementById("reviewDots");

        if (cards.length === 0) return;

        /* ==========================================
           CREATE DOTS (idempotent)
        ========================================== */
        if (dotsContainer) {
            dotsContainer.innerHTML = "";
            cards.forEach((_, index) => {
                const dot = document.createElement("button");
                dot.type = "button";
                dot.setAttribute("aria-label", `Go to patient review ${index + 1}`);
                dot.className =
                    "h-1.5 rounded-full bg-slate-200 transition-all duration-300 cursor-pointer focus:outline-hidden";
                dot.style.width = "20px";

                dot.addEventListener("click", () => {
                    scrollToCard(index);
                });

                dotsContainer.appendChild(dot);
            });
        }

        const dots = dotsContainer ? [...dotsContainer.children] : [];

        /* ==========================================
           SCROLL TO CARD
        ========================================== */
        function scrollToCard(index) {
            const card = cards[index];
            if (!card || !slider) return;

            const isDesktop = window.innerWidth >= 1024;
            const sliderRect = slider.getBoundingClientRect();
            const cardRect = card.getBoundingClientRect();

            let scrollAmount;
            if (isDesktop) {
                scrollAmount = slider.scrollLeft + (cardRect.left - sliderRect.left);
            } else {
                scrollAmount =
                    cardRect.left -
                    sliderRect.left +
                    slider.scrollLeft -
                    (slider.clientWidth - card.clientWidth) / 2;
            }

            slider.scrollTo({
                left: Math.max(0, scrollAmount),
                behavior: "smooth",
            });

            updateActiveDot(index);
        }

        /* ==========================================
           FIND CLOSEST CARD
        ========================================== */
        function getClosestCardIndex() {
            if (!slider || cards.length === 0) return 0;

            if (slider.scrollLeft <= 15) return 0;
            if (slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 15) {
                return cards.length - 1;
            }

            const sliderRect = slider.getBoundingClientRect();
            const isDesktop = window.innerWidth >= 1024;
            const targetPoint = isDesktop
                ? sliderRect.left + 50
                : sliderRect.left + sliderRect.width / 2;

            let closestIndex = 0;
            let closestDistance = Infinity;

            cards.forEach((card, index) => {
                const cardRect = card.getBoundingClientRect();
                const refPoint = isDesktop ? cardRect.left : cardRect.left + cardRect.width / 2;
                const distance = Math.abs(refPoint - targetPoint);

                if (distance < closestDistance) {
                    closestDistance = distance;
                    closestIndex = index;
                }
            });

            return closestIndex;
        }

        /* ==========================================
           PREVIOUS / NEXT BUTTONS
        ========================================== */
        if (prevButton && !prevButton.dataset.sliderInit) {
            prevButton.dataset.sliderInit = "true";
            prevButton.addEventListener("click", () => {
                const current = getClosestCardIndex();
                const nextIndex = current <= 0 ? cards.length - 1 : current - 1;
                scrollToCard(nextIndex);
            });
        }

        if (nextButton && !nextButton.dataset.sliderInit) {
            nextButton.dataset.sliderInit = "true";
            nextButton.addEventListener("click", () => {
                const current = getClosestCardIndex();
                const nextIndex = current >= cards.length - 1 ? 0 : current + 1;
                scrollToCard(nextIndex);
            });
        }

        /* ==========================================
           ACTIVE DOT
        ========================================== */
        function updateActiveDot(index) {
            dots.forEach((dot, dotIndex) => {
                if (dotIndex === index) {
                    dot.classList.remove("bg-slate-200");
                    dot.classList.add("bg-teal-600");
                    dot.style.width = "32px";
                } else {
                    dot.classList.remove("bg-teal-600");
                    dot.classList.add("bg-slate-200");
                    dot.style.width = "20px";
                }
            });
        }

        /* ==========================================
           UPDATE AFTER MANUAL SWIPE (DEBOUNCED)
        ========================================== */
        let scrollTimeout;
        if (!slider.dataset.sliderScrollInit) {
            slider.dataset.sliderScrollInit = "true";
            slider.addEventListener(
                "scroll",
                () => {
                    clearTimeout(scrollTimeout);
                    scrollTimeout = setTimeout(() => {
                        const index = getClosestCardIndex();
                        updateActiveDot(index);
                    }, 60);
                },
                { passive: true },
            );
        }

        /* ==========================================
           FACADE / PLAY ON DEMAND LOGIC
        ========================================== */
        const allVideos = slider.querySelectorAll(".review-video");

        containers.forEach((container) => {
            if (container.dataset.facadeInit) return;
            container.dataset.facadeInit = "true";

            const video = container.querySelector(".review-video");
            const overlay = container.querySelector(".play-overlay");

            if (!video) return;

            const handlePlay = () => {
                // Pause all other videos
                allVideos.forEach((v) => {
                    if (v !== video) {
                        v.pause();
                        v.closest(".video-container")?.classList.remove("is-playing");
                    }
                });

                if (video.paused) {
                    video.play().then(() => {
                        container.classList.add("is-playing");
                    }).catch(() => {});
                } else {
                    video.pause();
                    container.classList.remove("is-playing");
                }
            };

            overlay?.addEventListener("click", (e) => {
                e.stopPropagation();
                handlePlay();
            });

            video.addEventListener("play", () => {
                container.classList.add("is-playing");
                allVideos.forEach((v) => {
                    if (v !== video) {
                        v.pause();
                        v.closest(".video-container")?.classList.remove("is-playing");
                    }
                });
            });

            video.addEventListener("pause", () => {
                container.classList.remove("is-playing");
            });

            video.addEventListener("ended", () => {
                container.classList.remove("is-playing");
            });
        });

        /* ==========================================
           AUTO-PAUSE VIDEOS WHEN SCROLLED OUT OF VIEW
        ========================================== */
        if ("IntersectionObserver" in window) {
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (!entry.isIntersecting) {
                            const video = entry.target.querySelector("video");
                            if (video && !video.paused) {
                                video.pause();
                                entry.target.classList.remove("is-playing");
                            }
                        }
                    });
                },
                { threshold: 0.3 }
            );

            containers.forEach((c) => observer.observe(c));
        }

        /* ==========================================
           INITIAL STATE
        ========================================== */
        updateActiveDot(0);

        /* ==========================================
           KEYBOARD SUPPORT
        ========================================== */
        if (!slider.dataset.sliderKeyInit) {
            slider.dataset.sliderKeyInit = "true";
            slider.addEventListener("keydown", (event) => {
                if (event.key === "ArrowRight") {
                    event.preventDefault();
                    nextButton?.click();
                }
                if (event.key === "ArrowLeft") {
                    event.preventDefault();
                    prevButton?.click();
                }
            });
        }
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupReviewSlider);
    } else {
        setupReviewSlider();
    }
    document.addEventListener("astro:page-load", setupReviewSlider);
</script>
