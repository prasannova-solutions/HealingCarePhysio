---
// PatientReviews.astro
---

<!-- =========================================================
     PATIENT STORIES / VIDEO REVIEWS
========================================================= -->
<section
    id="patient-stories"
    class="relative overflow-hidden bg-[#f7fbfa] py-20 sm:py-24 lg:py-32"
>
    <!-- =========================
         BACKGROUND DECORATION
    ========================== -->

    <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <!-- Large soft circle -->
        <div
            class="absolute -left-32 top-20 h-72 w-72 rounded-full
                   bg-teal-100/50 blur-3xl sm:h-96 sm:w-96"
        >
        </div>

        <!-- Right circle -->
        <div
            class="absolute -right-40 top-1/3 h-96 w-96 rounded-full
                   bg-cyan-100/40 blur-3xl"
        >
        </div>

        <!-- Bottom glow -->
        <div
            class="absolute bottom-0 left-1/2 h-64 w-[70%]
                   -translate-x-1/2 rounded-full
                   bg-emerald-50 blur-3xl"
        >
        </div>

        <!-- Decorative SVG -->
        <svg
            class="absolute right-[5%] top-16 hidden h-32 w-32 text-teal-200/50 lg:block"
            viewBox="0 0 100 100"
            fill="none"
        >
            <circle
                cx="50"
                cy="50"
                r="38"
                stroke="currentColor"
                stroke-width="1"
                stroke-dasharray="4 6"></circle>
            <circle
                cx="50"
                cy="50"
                r="24"
                stroke="currentColor"
                stroke-width="1"
                stroke-dasharray="2 5"></circle>
        </svg>
    </div>

    <!-- =========================
         CONTENT
    ========================== -->

    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- HEADER -->
        <div class="mx-auto max-w-3xl text-center">
            <!-- Eyebrow -->
            <div
                class="mb-5 inline-flex items-center gap-2 rounded-full
                       border border-teal-100 bg-white/80 px-4 py-2
                       text-xs font-semibold uppercase tracking-[0.18em]
                       text-teal-700 shadow-xs backdrop-blur"
            >
                <span class="flex h-2 w-2 rounded-full bg-teal-500"></span>
                Patient Stories
            </div>

            <!-- Heading -->
            <h2
                class="text-3xl font-bold tracking-tight text-slate-900
                       sm:text-4xl lg:text-5xl"
            >
                Real People.
                <span class="text-teal-600"> Real Recovery. </span>
            </h2>

            <!-- Description -->
            <p
                class="mx-auto mt-5 max-w-2xl text-sm leading-7
                       text-slate-600 sm:text-base"
            >
                Hear directly from our patients about their experience,
                treatment journey, and the difference personalised physiotherapy
                made in their recovery.
            </p>
        </div>

        <!-- =========================
             DESKTOP CONTROLS
        ========================== -->

        <div
            class="mt-10 hidden items-center justify-between
                   lg:flex"
        >
            <div>
                <p class="text-sm font-medium text-slate-500">
                    Patient experiences
                </p>

                <p class="mt-1 text-xs text-slate-400">
                    Swipe or use the arrows to explore
                </p>
            </div>

            <div class="flex items-center gap-3">
                <!-- Previous -->
                <button
                    id="reviewPrev"
                    type="button"
                    aria-label="Previous patient review"
                    class="group flex h-11 w-11 items-center justify-center
                           rounded-full border border-slate-200
                           bg-white text-slate-600 shadow-xs
                           transition-all duration-300
                           hover:-translate-y-0.5
                           hover:border-teal-200
                           hover:bg-teal-50
                           hover:text-teal-600 cursor-pointer"
                >
                    <svg
                        class="h-5 w-5 transition-transform
                               group-hover:-translate-x-0.5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                    >
                        <path
                            d="M15 18l-6-6 6-6"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </svg>
                </button>

                <!-- Next -->
                <button
                    id="reviewNext"
                    type="button"
                    aria-label="Next patient review"
                    class="group flex h-11 w-11 items-center justify-center
                           rounded-full bg-teal-600 text-white shadow-lg
                           shadow-teal-600/20
                           transition-all duration-300
                           hover:-translate-y-0.5
                           hover:bg-teal-700 cursor-pointer"
                >
                    <svg
                        class="h-5 w-5 transition-transform
                               group-hover:translate-x-0.5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                    >
                        <path
                            d="M9 18l6-6-6-6"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </svg>
                </button>
            </div>
        </div>

        <!-- =========================
             VIDEO SLIDER
        ========================== -->

