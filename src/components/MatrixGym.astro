<style>
  /* =====================================================
     MOBILE HORIZONTAL EXPERIENCE
  ===================================================== */

  .matrix-mobile-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;

    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;

    padding-left: 1px;
    padding-right: 28px;

    -webkit-overflow-scrolling: touch;
  }

  .matrix-mobile-scroll::-webkit-scrollbar {
    display: none;
  }

  .matrix-mobile-card {
    width: min(62vw, 235px);
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .matrix-dot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: rgb(203 213 225);
    transition:
      width 0.25s ease,
      background 0.25s ease;
  }

  .matrix-dot.active {
    width: 20px;
    background: rgb(13 148 136);
  }

  @media (prefers-reduced-motion: reduce) {
    .matrix-dot {
      transition: none;
    }
  }
</style>


<script>
  const matrixScroll = document.querySelector(".matrix-mobile-scroll");
  const matrixCards = document.querySelectorAll(".matrix-mobile-card");
  const matrixDots = document.querySelectorAll(".matrix-dot");

  if (matrixScroll && matrixCards.length && matrixDots.length) {
    let ticking = false;

    const updateActiveCard = () => {
      const scrollLeft = matrixScroll.scrollLeft;
      const cardWidth =
        matrixCards[0].getBoundingClientRect().width + 12;

      const activeIndex = Math.min(
        matrixCards.length - 1,
        Math.max(0, Math.round(scrollLeft / cardWidth))
      );

      matrixDots.forEach((dot, index) => {
        dot.classList.toggle("active", index === activeIndex);
      });

      ticking = false;
    };

    matrixScroll.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateActiveCard);
          ticking = true;
        }
      },
      { passive: true }
    );
  }
</script>