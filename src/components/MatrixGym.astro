---
// MatrixGym.astro
// Matrix Physio Gym & Medical Fitness Center

const gymFeatures = [
  {
    icon: "📊",
    title: "Free Body Mass (BMI & Body Fat) Analysis",
    badge: "Complimentary",
    desc: "Complete body composition profiling measuring visceral fat, muscle mass symmetry, and basal metabolic rate to calibrate your fitness baseline.",
  },
  {
    icon: "🧖",
    title: "Steam Bath & Recovery Hydrotherapy",
    badge: "Recovery Spa",
    desc: "Therapeutic high-temperature steam bath to flush lactic acid, improve joint circulation, release deep muscle stiffness, and accelerate post-workout recovery.",
  },
  {
    icon: "👩",
    title: "Exclusive Dedicated Batches for Women",
    badge: "100% Privacy",
    desc: "Safe, empowering, and completely private workout hours tailored specifically for women, guided by female trainers and certified health specialists.",
  },
  {
    icon: "🧘",
    title: "Yoga & Mat Pilates Sessions",
    badge: "Mind & Core",
    desc: "Flexibility, core stabilization, and breathwork classes focused on improving spinal alignment, reducing stress, and building deep postural strength.",
  },
  {
    icon: "💃",
    title: "High-Energy Zumba Dance Fitness",
    badge: "Cardio Fun",
    desc: "Dynamic, music-driven aerobic conditioning sessions designed to torch calories, improve cardiovascular endurance, and elevate daily stamina.",
  },
  {
    icon: "🥗",
    title: "Clinical Diet & Weight Management",
    badge: "Certified Dietitian",
    desc: "Personalized medical nutrition and sustainable weight loss blueprints crafted directly by Dr. Tejaswini Kasar (Certified Clinical Dietitian).",
  },
  {
    icon: "🏋️",
    title: "Advanced Medical-Grade Gym Equipment",
    badge: "Joint-Friendly",
    desc: "State-of-the-art strength and cardio machines engineered to build athletic power without placing dangerous stress on recovering joints.",
  },
  {
    icon: "🏅",
    title: "Experienced Health Coaches & Rehab Trainers",
    badge: "Expert Guided",
    desc: "Certified trainers collaborating directly with physiotherapists to ensure safe form, zero re-injury risk, and measurable progress.",
  },
];
---

<section
  id="matrix-gym"
  class="relative overflow-hidden bg-[#f4faf9] py-20 sm:py-28 lg:py-32"
>
  <!-- Decorative Glow Layer -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div
      class="absolute -right-40 top-1/4 h-[500px] w-[500px] rounded-full bg-emerald-100/60 blur-[130px]"
    >
    </div>
    <div
      class="absolute -left-40 bottom-1/4 h-[500px] w-[500px] rounded-full bg-teal-100/50 blur-[130px]"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="max-w-3xl">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-teal-200 bg-white/90 px-4 py-1.5 shadow-xs backdrop-blur"
      >
        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
        <span
          class="text-xs font-bold uppercase tracking-wider text-teal-900"
        >
          Integrated Medical Fitness & Wellness
        </span>
      </div>

      <h2
        class="mt-6 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl leading-[1.12]"
      >
        Matrix Physio Gym & <br />
        <span class="text-teal-700">Health Transformation Center</span>
      </h2>

      <p class="mt-5 text-base sm:text-lg leading-relaxed text-slate-600">
        Where clinical rehabilitation meets athletic performance. Matrix Physio
        Gym provides a doctor-supervised fitness ecosystem featuring steam bath
        recovery, women's private batches, Zumba, Yoga, and personalized clinical
        nutrition.
      </p>
    </div>

    <!-- Features 8-Grid -->
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        gymFeatures.map((feat) => (
          <div class="group flex flex-col justify-between rounded-3xl border border-slate-200/90 bg-white p-6 shadow-[0_8px_30px_rgba(15,118,110,0.04)] transition duration-300 hover:-translate-y-1.5 hover:border-teal-400 hover:shadow-[0_20px_40px_rgba(15,118,110,0.1)]">
            <div>
              <div class="flex items-center justify-between">
                <span class="text-3xl">{feat.icon}</span>
                <span class="rounded-full bg-teal-50 border border-teal-200/60 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-teal-800">
                  {feat.badge}
                </span>
              </div>

              <h3 class="mt-5 text-base font-bold text-slate-900 group-hover:text-teal-800 transition-colors">
                {feat.title}
              </h3>

              <p class="mt-2.5 text-xs leading-relaxed text-slate-600">
                {feat.desc}
              </p>
            </div>

            <div class="mt-5 pt-3 border-t border-slate-100 flex items-center text-[11px] font-semibold text-teal-700">
              <span>Doctor Supervised</span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Free Body Composition Banner & Membership CTA -->
    <div
      class="mt-14 rounded-3xl border border-teal-200 bg-gradient-to-r from-slate-900 via-teal-950 to-slate-900 p-8 sm:p-10 text-white shadow-xl"
    >
      <div
        class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between"
      >
        <div class="space-y-2">
          <div class="inline-flex items-center gap-2 rounded-full bg-emerald-500/20 border border-emerald-400/30 px-3 py-1 text-xs font-bold text-emerald-300">
            <span>🎁 Limited Time Clinic Offer</span>
          </div>
          <h4 class="text-2xl sm:text-3xl font-extrabold text-white">
            Claim Your 100% Free Body Mass & BMI Analysis
          </h4>
          <p class="text-xs sm:text-sm text-slate-300 max-w-2xl">
            Visit Matrix Physio Gym on Bhadgaon Road, Gadhinglaj. Our health
            coaches will analyze your body composition, muscle balance, and fat
            percentage with zero obligation.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3 shrink-0">
          <a
            href="tel:7798202182"
            class="inline-flex items-center gap-2 rounded-xl bg-teal-400 px-6 py-3.5 text-xs sm:text-sm font-bold text-slate-950 shadow-lg shadow-teal-400/20 transition hover:bg-teal-300 hover:scale-105"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"/>
            </svg>
            <span>Book Free Analysis</span>
          </a>

          <a
            href="https://www.instagram.com/matrix_physio_gym/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl border border-slate-700 bg-slate-800/80 px-5 py-3.5 text-xs sm:text-sm font-bold text-slate-200 transition hover:bg-slate-700 hover:text-white"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span>@matrix_physio_gym</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
