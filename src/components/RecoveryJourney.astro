---
// RecoveryJourney.astro
// 5-Step Evidence-Based Clinical Pathway from Assessment to Full Functional Independence

const steps = [
  {
    step: "01",
    title: "Comprehensive Clinical Assessment",
    badge: "Day 1 Triage",
    desc: "Every patient has unique physical needs. We conduct orthopedic biomechanics testing, posture analysis, neuro-tension evaluations, and range-of-motion mapping.",
    points: [
      "Root-cause diagnosis beyond surface symptoms",
      "Muscle imbalance & joint mobility indexing",
      "Clear, honest prognosis & recovery timeline",
    ],
  },
  {
    step: "02",
    title: "Personalized Treatment Design",
    badge: "Custom Blueprint",
    desc: "A tailored medical care plan combining world-class physical therapy, pain modulation modalities, and customized nutritional support.",
    points: [
      "Targeted pain relief protocols (zero reliance on painkillers)",
      "Bespoke frequency & session scheduling",
      "Integration of clinical dietary guidance",
    ],
  },
  {
    step: "03",
    title: "Advanced Clinical Rehabilitation",
    badge: "Therapeutic Phase",
    desc: "Utilizing advanced modalities including Robotic Traction, Dry Needling, Chiropractic adjustments, and Matrix Rhythm Therapy to restore tissue health.",
    points: [
      "Rapid reduction of acute & chronic inflammation",
      "Spinal & joint decompression techniques",
      "Deep trigger point & myofascial release",
    ],
  },
  {
    step: "04",
    title: "Strength, Mobility & Stability",
    badge: "Active Rebuilding",
    desc: "Rebuilding muscular endurance, joint stabilizers, balance, and proprioception to prevent relapse and support long-term movement confidence.",
    points: [
      "Corrective functional movement retraining",
      "Core & postural stability conditioning",
      "Balance and fall-prevention protocols",
    ],
  },
  {
    step: "05",
    title: "Functional Recovery & Independence",
    badge: "Lifelong Health",
    desc: "Achieving total physical independence, seamless return to daily activities, workplace ergonomics, and return-to-sport clearance.",
    points: [
      "Confidence in walking, lifting, and bending",
      "Return-to-play athletic testing",
      "Personalized home exercise & injury prevention plan",
    ],
  },
];

const patientGoals = [
  { icon: "✨", text: "Move with zero or reduced pain" },
  { icon: "💪", text: "Regain lost muscular strength" },
  { icon: "🔄", text: "Restore full joint mobility & flexibility" },
  { icon: "🚶", text: "Walk and climb stairs with total confidence" },
  { icon: "🩹", text: "Rapid recovery from sports & post-op injuries" },
  { icon: "🏃", text: "Safe return to exercise, gym & athletic sports" },
  { icon: "🏡", text: "Perform household & daily work comfortably" },
  { icon: "🌟", text: "Attain complete physical self-reliance" },
];
---

<section
  id="approach"
  class="relative overflow-hidden bg-white py-20 sm:py-28 lg:py-32"
>
  <!-- Subtle Background Gradients -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div
      class="absolute left-1/2 top-0 h-[600px] w-[800px] -translate-x-1/2 rounded-full bg-gradient-to-b from-teal-50/80 via-cyan-50/40 to-transparent blur-3xl"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-teal-200 bg-teal-50/80 px-4 py-1.5 backdrop-blur"
      >
        <span class="h-2 w-2 rounded-full bg-teal-600"></span>
        <span class="text-xs font-bold uppercase tracking-wider text-teal-900">
          Our 5-Stage Clinical Framework
        </span>
      </div>

      <h2
        class="mt-5 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl"
      >
        From Diagnosis to <br />
        <span class="text-teal-700">Full Physical Independence</span>
      </h2>

      <p class="mt-4 text-base sm:text-lg text-slate-600">
        We don't offer generic exercises. Every treatment follows a strict,
        measurable 5-stage medical trajectory to guarantee lasting results.
      </p>
    </div>

    <!-- 5-Step Process Timeline Cards -->
    <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {
        steps.map((item, idx) => (
          <div class="group relative flex flex-col justify-between rounded-3xl border border-slate-200/90 bg-slate-50/50 p-6 transition duration-300 hover:-translate-y-1.5 hover:border-teal-500/80 hover:bg-white hover:shadow-[0_20px_40px_rgba(15,118,110,0.08)]">
            <div>
              <!-- Step Header -->
              <div class="flex items-center justify-between">
                <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-teal-700 text-sm font-black text-white shadow-md shadow-teal-700/20 group-hover:scale-110 transition-transform">
                  {item.step}
                </span>
                <span class="text-[10px] font-bold uppercase tracking-wider text-teal-800 bg-teal-50 border border-teal-200/60 rounded-full px-2.5 py-0.5">
                  {item.badge}
                </span>
              </div>

              <!-- Title -->
              <h3 class="mt-5 text-lg font-bold text-slate-900 group-hover:text-teal-800 transition-colors">
                {item.title}
              </h3>

              <!-- Description -->
              <p class="mt-3 text-xs leading-relaxed text-slate-600">
                {item.desc}
              </p>
            </div>

            <!-- Bullet Points -->
            <ul class="mt-5 space-y-2 border-t border-slate-200/60 pt-4 text-[11px] text-slate-600">
              {item.points.map((p) => (
                <li class="flex items-start gap-1.5">
                  <span class="text-teal-600 font-bold">✓</span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Patient Goals Bar (Page 2 from PDF) -->
    <div
      class="mt-16 rounded-3xl border border-teal-100 bg-[#f7fcfb] p-8 sm:p-10"
    >
      <div class="max-w-3xl">
        <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900">
          Our Patient Recovery Commitments
        </h3>
        <p class="mt-2 text-sm text-slate-600">
          Every session is designed to move you measurably closer to these 8 core physical milestones:
        </p>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          patientGoals.map((goal) => (
            <div class="flex items-center gap-3 rounded-2xl border border-slate-200/70 bg-white p-3.5 shadow-2xs transition hover:border-teal-400">
              <span class="text-lg">{goal.icon}</span>
              <span class="text-xs font-semibold text-slate-800">
                {goal.text}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
