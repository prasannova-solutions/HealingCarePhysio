---
// ResidentialHospital.astro
// In-Patient Residential Rehabilitation Care for Regional & Distant Patients

const hospitalFeatures = [
  {
    icon: "🛏️",
    title: "24/7 Assisted Residential Recovery",
    desc: "Comfortable in-patient stay facilities equipped for patients requiring dedicated assistance, daily monitoring, and intensive care.",
  },
  {
    icon: "⚡",
    title: "Multi-Session Daily Intensive Therapy",
    desc: "Accelerated recovery protocols with 2 to 3 supervised physiotherapy sessions per day to dramatically shorten hospital stay and regain mobility.",
  },
  {
    icon: "🗺️",
    title: "Serving Maharashtra & Karnataka",
    desc: "Specially established to support outstation families from Kolhapur, Belgaum, Nipani, Sankeshwar, Ajara, Chandgad, and rural belts.",
  },
  {
    icon: "🧠",
    title: "Neurological & Stroke Care Center",
    desc: "Specialized parallel bars, weight-supported harness, and neuro-developmental therapy for stroke, paralysis, and spinal trauma survivors.",
  },
  {
    icon: "🩺",
    title: "Post-Surgical Joint & Fracture Care",
    desc: "Immediate post-op continuous passive motion (CPM), wound-safe mobilization, and rapid recovery after knee/hip replacement surgery.",
  },
  {
    icon: "🥗",
    title: "Clinical Diet & In-House Nutrition",
    desc: "Personalized anti-inflammatory meal planning managed directly by Dr. Tejaswini Kasar (Certified Clinical Dietitian) for fast tissue healing.",
  },
];
---

<section
  id="residential-hospital"
  class="relative overflow-hidden bg-gradient-to-b from-[#0a151d] to-[#0d1e29] py-20 sm:py-28 lg:py-32 text-white"
>
  <!-- Background Glow Accents -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div
      class="absolute left-1/4 top-10 h-[500px] w-[500px] rounded-full bg-teal-500/10 blur-[130px]"
    >
    </div>
    <div
      class="absolute right-10 bottom-10 h-[400px] w-[400px] rounded-full bg-cyan-600/10 blur-[120px]"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header Grid -->
    <div
      class="grid items-end gap-8 lg:grid-cols-12 lg:gap-12 pb-12 border-b border-slate-800"
    >
      <div class="lg:col-span-7">
        <div
          class="inline-flex items-center gap-2 rounded-full border border-teal-500/40 bg-teal-950/70 px-4 py-1.5 backdrop-blur"
        >
          <span class="h-2 w-2 rounded-full bg-teal-400"></span>
          <span
            class="text-xs font-bold uppercase tracking-widest text-teal-300"
          >
            In-Patient Residential Hospital
          </span>
        </div>

        <h2
          class="mt-6 text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl leading-[1.1]"
        >
          Dedicated Residential Care for <br />
          <span
            class="bg-gradient-to-r from-teal-300 via-cyan-300 to-emerald-300 bg-clip-text text-transparent"
          >
            Distant & Complex Patients
          </span>
        </h2>
      </div>

      <div class="lg:col-span-5">
        <p class="text-sm sm:text-base leading-relaxed text-slate-300">
          Recognizing that patients from rural Kolhapur and Karnataka struggle
          with daily commuting, Healing Care Physio established a dedicated
          residential hospital. Patients stay on-site with round-the-clock
          rehabilitation until they achieve complete physical independence.
        </p>
      </div>
    </div>

    <!-- Hospital Features Grid -->
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        hospitalFeatures.map((feat) => (
          <div class="group relative flex flex-col justify-between rounded-3xl border border-slate-800/80 bg-slate-900/60 p-7 backdrop-blur-md transition duration-300 hover:border-teal-500/50 hover:bg-slate-900/90 hover:shadow-[0_20px_50px_rgba(13,148,136,0.12)]">
            <div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-teal-500/10 border border-teal-500/20 text-2xl group-hover:scale-110 transition-transform">
                {feat.icon}
              </div>

              <h3 class="mt-6 text-lg font-bold text-white group-hover:text-teal-300 transition-colors">
                {feat.title}
              </h3>

              <p class="mt-3 text-xs sm:text-sm leading-relaxed text-slate-300">
                {feat.desc}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-800/70 flex items-center gap-2 text-xs font-semibold text-teal-400">
              <span>Full Medical Supervision</span>
              <span class="text-slate-600">•</span>
              <span>24/7 Support</span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Distance & Admission Action Bar -->
    <div
      class="mt-14 rounded-3xl border border-teal-500/30 bg-gradient-to-r from-teal-950/80 via-slate-900 to-teal-950/80 p-8 sm:p-10 backdrop-blur-xl"
    >
      <div
        class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between"
      >
        <div>
          <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-teal-300">
            <span>📍 Regional Coverage</span>
          </div>
          <h4 class="mt-1 text-xl sm:text-2xl font-bold text-white">
            Traveling from Kolhapur, Belgaum, or Karnataka?
          </h4>
          <p class="mt-2 text-xs sm:text-sm text-slate-300 max-w-2xl">
            We provide pre-admission evaluations, room bookings for patients and
            accompanying attendants, and comprehensive in-patient recovery
            packages.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href="tel:9607378772"
            class="inline-flex items-center gap-2 rounded-xl bg-teal-500 px-5 py-3 text-xs font-bold text-slate-950 shadow-lg shadow-teal-500/20 transition hover:bg-teal-400 hover:scale-105"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"/>
            </svg>
            <span>Inquire About In-Patient Stay</span>
          </a>

          <a
            href="https://wa.me/919607378772?text=Hello%20Healing%20Care%20Physio,%20I%20would%20like%20to%20inquire%20about%20Residential%20Hospital%20In-Patient%20admission."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl border border-teal-500/40 bg-teal-500/10 px-5 py-3 text-xs font-bold text-teal-300 transition hover:bg-teal-500/20"
          >
            <span>Chat on WhatsApp</span>
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
