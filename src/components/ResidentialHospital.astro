---
// ResidentialHospital.astro

const hospitalFeatures = [
  {
    image: "/ResidentialHospital/residential_recovery.jpg",
    tag: "In-Patient Care",
    title: "24/7 Assisted Residential Recovery",
    short: "Comfortable on-site stay with continuous assistance and monitoring.",
    feature: "24/7 Supervision",
    icon: "shield",
    featured: true,
  },
  {
    image: "/ResidentialHospital/intensive_therapy.jpg",
    tag: "Accelerated Rehab",
    title: "Multi-Session Daily Therapy",
    short: "2–3 supervised therapy sessions designed for focused recovery.",
    feature: "2–3 Sessions Daily",
    icon: "bolt",
  },
  {
    image: "/ResidentialHospital/regional_care.jpg",
    tag: "Regional Outreach",
    title: "Care for Outstation Families",
    short: "Supporting patients travelling from Maharashtra and Karnataka.",
    feature: "Outstation Support",
    icon: "location",
  },
  {
    image: "/ResidentialHospital/neuro_stroke_care.jpg",
    tag: "Neuro Rehab",
    title: "Stroke & Neurological Recovery",
    short: "Specialized rehabilitation for mobility, balance and gait training.",
    feature: "Gait Training",
    icon: "brain",
  },
  {
    image: "/ResidentialHospital/post_surgical_care.jpg",
    tag: "Post-Operative",
    title: "Joint & Fracture Rehabilitation",
    short: "Safe early mobilization following surgery and orthopedic treatment.",
    feature: "CPM Mobilization",
    icon: "joint",
  },
  {
    image: "/ResidentialHospital/clinical_nutrition.jpg",
    tag: "Diet & Healing",
    title: "Clinical Nutrition Support",
    short: "Dietitian-guided nutrition to support recovery and healing.",
    feature: "Dietitian Guided",
    icon: "nutrition",
  },
];
---

<section
  id="residential-hospital"
  class="relative overflow-hidden bg-[#09141b] py-16 sm:py-20 lg:py-28 text-white"
>
  <!-- Optimized Background -->
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-teal-400/40 to-transparent"></div>

    <div
      class="absolute -right-40 top-20 h-[500px] w-[500px] rounded-full bg-teal-500/[0.06] blur-[100px]"
    ></div>

    <div
      class="absolute -left-40 bottom-0 h-[400px] w-[400px] rounded-full bg-cyan-500/[0.05] blur-[100px]"
    ></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <!-- HEADER -->
    <div class="max-w-4xl">

      <div
        class="inline-flex items-center gap-2 rounded-full border border-teal-400/20 bg-teal-400/[0.06] px-3.5 py-1.5"
      >
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal-400 opacity-40"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-teal-400"></span>
        </span>

        <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-teal-300 sm:text-xs">
          Residential Rehabilitation
        </span>
      </div>

      <div class="mt-5 grid gap-5 lg:grid-cols-[1.3fr_.7fr] lg:items-end">

        <div>
          <h2
            class="text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl lg:leading-[1.05]"
          >
            Recovery doesn't have to
            <span class="block text-teal-300">
              depend on distance.
            </span>
          </h2>
        </div>

        <p class="max-w-xl text-sm leading-relaxed text-slate-400 sm:text-base">
          A dedicated residential rehabilitation experience for patients who
          need focused, continuous care without the burden of daily travel.
        </p>

      </div>
    </div>


    <!-- ========================= -->
    <!-- DESKTOP LAYOUT -->
    <!-- ========================= -->

    <div class="mt-10 hidden lg:grid lg:grid-cols-12 lg:gap-5">

      <!-- FEATURED CARD -->
      <article
        class="group relative col-span-7 min-h-[460px] overflow-hidden rounded-[2rem] border border-white/[0.08] bg-slate-900"
      >
        <img
          src={hospitalFeatures[0].image}
          alt={hospitalFeatures[0].title}
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.04]"
        />

        <div
          class="absolute inset-0 bg-gradient-to-t from-[#081218] via-[#081218]/50 to-transparent"
        ></div>

        <div class="absolute inset-x-0 bottom-0 p-8 xl:p-10">

          <div
            class="mb-5 inline-flex items-center gap-2 rounded-full border border-teal-300/20 bg-black/30 px-3 py-1.5 text-xs font-semibold text-teal-200"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-teal-300"></span>
            {hospitalFeatures[0].tag}
          </div>

          <h3 class="max-w-xl text-3xl font-bold leading-tight text-white">
            {hospitalFeatures[0].title}
          </h3>

          <p class="mt-3 max-w-lg text-sm leading-relaxed text-slate-300">
            {hospitalFeatures[0].short}
          </p>

          <div class="mt-6 flex items-center gap-3">
            <div
              class="flex h-10 w-10 items-center justify-center rounded-xl bg-teal-400 text-slate-950"
            >
              <svg
                class="h-5 w-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.2"
                  d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                />
              </svg>
            </div>

            <div>
              <div class="text-[10px] uppercase tracking-widest text-slate-400">
                Dedicated Care
              </div>

              <div class="text-sm font-bold text-white">
                {hospitalFeatures[0].feature}
              </div>
            </div>
          </div>

        </div>
      </article>


      <!-- COMPACT CARDS -->
      <div class="col-span-5 grid grid-cols-2 gap-5">

        {
          hospitalFeatures.slice(1).map((feat, index) => (
            <article
              class:list={[
                "group relative overflow-hidden rounded-[1.5rem] border border-white/[0.08] bg-[#0d1c24] transition duration-300 hover:-translate-y-1 hover:border-teal-400/30",
                index === 4 ? "col-span-2" : "",
              ]}
            >

              <div class:list={[
                "relative overflow-hidden",
                index === 4 ? "h-32" : "h-28",
              ]}>
                <img
                  src={feat.image}
                  alt={feat.title}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                />

                <div class="absolute inset-0 bg-gradient-to-t from-[#0d1c24] to-transparent"></div>

                <span
                  class="absolute left-3 top-3 rounded-full bg-black/40 px-2.5 py-1 text-[9px] font-bold uppercase tracking-wider text-teal-200 backdrop-blur-sm"
                >
                  {feat.tag}
                </span>
              </div>

              <div class="p-5">

                <h3 class="text-sm font-bold leading-snug text-white">
                  {feat.title}
                </h3>

                <p class="mt-2 text-xs leading-relaxed text-slate-400">
                  {feat.short}
                </p>

                <div class="mt-4 flex items-center gap-2 text-[10px] font-bold uppercase tracking-wider text-teal-300">
                  <span class="h-1.5 w-1.5 rounded-full bg-teal-400"></span>
                  {feat.feature}
                </div>

              </div>
            </article>
          ))
        }

      </div>

    </div>


    <!-- ========================= -->
    <!-- MOBILE SWIPE EXPERIENCE -->
    <!-- ========================= -->

    <div class="mt-8 lg:hidden">

      <div
        class="scrollbar-hide flex snap-x snap-mandatory gap-3 overflow-x-auto pb-3 -mx-4 px-4"
      >
        {
          hospitalFeatures.map((feat, index) => (
            <article
              class:list={[
                "group relative w-[68vw] max-w-[260px] shrink-0 snap-start overflow-hidden rounded-2xl border border-white/[0.08]",
                index === 0
                  ? "bg-gradient-to-b from-teal-950/80 to-[#0d1c24]"
                  : "bg-[#0d1c24]",
              ]}
            >

              <!-- Image -->
              <div class="relative h-28 sm:h-32 overflow-hidden">

                <img
                  src={feat.image}
                  alt={feat.title}
                  loading={index < 2 ? "eager" : "lazy"}
                  decoding="async"
                  class="h-full w-full object-cover"
                />

                <div
                  class="absolute inset-0 bg-gradient-to-t from-[#0d1c24] via-transparent to-black/20"
                ></div>

                <span
                  class="absolute left-2.5 top-2.5 rounded-full border border-white/10 bg-black/50 px-2 py-0.5 text-[8px] font-bold uppercase tracking-wider text-teal-200 backdrop-blur-sm"
                >
                  {feat.tag}
                </span>

                <div
                  class="absolute bottom-2 left-2.5 flex h-6 w-6 items-center justify-center rounded-full bg-teal-400 text-[10px] font-black text-slate-950 shadow-sm"
                >
                  {String(index + 1).padStart(2, "0")}
                </div>

              </div>

              <!-- Content -->
              <div class="p-3.5">

                <h3 class="text-sm font-bold leading-snug text-white line-clamp-1">
                  {feat.title}
                </h3>

                <p class="mt-1 text-[11px] leading-relaxed text-slate-400 line-clamp-2">
                  {feat.short}
                </p>

                <div
                  class="mt-3 flex items-center justify-between border-t border-white/[0.06] pt-2.5"
                >
                  <span class="text-[9px] font-bold uppercase tracking-wider text-teal-300">
                    {feat.feature}
                  </span>

                  <svg
                    class="h-3.5 w-3.5 text-teal-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </div>

              </div>
            </article>
          ))
        }
      </div>


      <!-- Swipe Indicator -->
      <div class="mt-2 flex items-center justify-between px-1">

        <span class="text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500">
          Explore Residential Care
        </span>

        <div class="flex items-center gap-2 text-[10px] font-semibold text-teal-300">
          <span>Swipe</span>

          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 5l7 7-7 7m-7 0h11"
            />
          </svg>
        </div>

      </div>

    </div>


    <!-- ========================= -->
    <!-- COMPACT ADMISSION CTA -->
    <!-- ========================= -->

    <div
      class="mt-10 overflow-hidden rounded-[1.75rem] border border-teal-400/15 bg-[#0c2026]"
    >

      <div class="grid lg:grid-cols-[1fr_auto] lg:items-center">

        <!-- Left -->
        <div class="p-6 sm:p-8">

          <div class="flex items-start gap-4">

            <div
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-teal-400/10 text-teal-300"
            >
              <svg
                class="h-5 w-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                />
              </svg>
            </div>

            <div>
              <span
                class="text-[10px] font-bold uppercase tracking-[0.16em] text-teal-300"
              >
                Travelling for Treatment?
              </span>

              <h3 class="mt-1 text-xl font-bold text-white sm:text-2xl">
                Plan your residential recovery with us.
              </h3>

              <p class="mt-2 max-w-2xl text-xs leading-relaxed text-slate-400 sm:text-sm">
                Pre-admission consultation, residential stay arrangements and
                structured rehabilitation planning for patients travelling from
                Maharashtra and Karnataka.
              </p>
            </div>

          </div>

        </div>


        <!-- Actions -->
        <div
          class="flex flex-col gap-2 border-t border-white/[0.06] p-5 sm:flex-row sm:p-6 lg:border-l lg:border-t-0"
        >

          <a
            href="tel:9607378772"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-teal-400 px-5 py-3 text-xs font-bold text-[#071317] transition hover:bg-teal-300"
          >
            <svg
              class="h-4 w-4"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"
              />
            </svg>

            Call Us
          </a>


          <a
            href="https://wa.me/919607378772?text=Hello%20Healing%20Care%20Physio,%20I%20would%20like%20to%20know%20more%20about%20Residential%20Hospital%20admission%20and%20in-patient%20rehabilitation."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-teal-400/20 bg-teal-400/[0.05] px-5 py-3 text-xs font-bold text-teal-200 transition hover:bg-teal-400/10"
          >
            WhatsApp

            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 5l7 7-7 7m0 0H3"
              />
            </svg>
          </a>

        </div>

      </div>

    </div>

  </div>
</section>


<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>