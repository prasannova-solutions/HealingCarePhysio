---
// Footer Component for Healing Care Physio
const currentYear = 2026;

const quickLinks = [
  { name: "Treatments", href: "#treatments" },
  { name: "Conditions", href: "#conditions" },
  { name: "Our 5-Stage Approach", href: "#approach" },
  { name: "Residential Hospital", href: "#residential-hospital" },
  { name: "Matrix Physio Gym", href: "#matrix-gym" },
  { name: "5-Year Story", href: "#our-story" },
  { name: "Doctors", href: "#care-team" },
  { name: "Patient Reviews", href: "#patient-stories" },
  { name: "Appointment", href: "#appointment" },
];

const socialLinks = [
  {
    name: "Clinic",
    handle: "@healing_care_physio_matrix_gym",
    url: "https://www.instagram.com/healing_care_physio_matrix_gym",
    type: "instagram",
  },
  {
    name: "Dr. Vrishabh",
    handle: "@dr_vrishabh_kasar_",
    url: "https://www.instagram.com/dr_vrishabh_kasar_/",
    type: "instagram",
  },
  {
    name: "Dr. Tejaswini",
    handle: "@dr.tejaswini_v_kasar",
    url: "https://www.instagram.com/dr.tejaswini_v_kasar/",
    type: "instagram",
  },
  {
    name: "Matrix Physio Gym",
    handle: "@matrix_physio_gym",
    url: "https://www.instagram.com/matrix_physio_gym/",
    type: "instagram",
  },
  {
    name: "YouTube",
    handle: "@healing_care_physio",
    url: "https://www.youtube.com/@healing_care_physio/videos",
    type: "youtube",
  },
];
---

<footer class="relative bg-[#0b131e] text-slate-300 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <!-- Main Grid -->
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10"
    >
      <!-- Col 1: Brand & Clinic Info (lg: 4 cols) -->
      <div class="lg:col-span-4 space-y-4">
        <a href="#" class="inline-flex items-center gap-3 group">
          <div
            class="w-10 h-10 rounded-xl overflow-hidden bg-white p-1 border border-teal-500/30 flex items-center justify-center shrink-0"
          >
            <img
              src="/logo_.jpg"
              alt="Healing Care Physio Logo"
              class="w-full h-full object-contain"
              loading="lazy"
            />
          </div>
          <span
            class="text-xl font-bold tracking-tight text-white group-hover:text-teal-400 transition-colors"
          >
            Healing Care Physio
          </span>
        </a>

        <div
          class="inline-flex items-center gap-2 text-xs font-semibold tracking-wide text-teal-400 bg-teal-950/60 px-3 py-1.5 rounded-full border border-teal-800/60"
        >
          <span>Ortho • Neuro • Sports • Rehabilitation</span>
        </div>

        <p class="text-sm text-slate-400 flex items-start gap-2">
          <svg
            class="w-4 h-4 text-teal-400 shrink-0 mt-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span class="leading-relaxed">
            2nd Floor, Above Wellness Medical, Bhadgaon Road, Gadhinglaj, Dist. Kolhapur - 416502
          </span>
        </p>
      </div>

      <!-- Col 2: Quick Links (lg: 2 cols) -->
      <div class="lg:col-span-2 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">
          Quick Links
        </h4>
        <ul class="space-y-2 text-sm">
          {
            quickLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-slate-400 hover:text-teal-300 transition-colors inline-block py-0.5"
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: Get in Touch (lg: 3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">
          Get in Touch
        </h4>
        <div class="space-y-2.5 text-sm">
          <a
            href="tel:+919607378772"
            class="flex items-center gap-2.5 text-slate-300 hover:text-teal-300 transition-colors group"
          >
            <div
              class="w-8 h-8 rounded-lg bg-slate-800 border border-slate-700/80 flex items-center justify-center text-teal-400 group-hover:border-teal-500/50 transition-colors shrink-0"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
            </div>
            <span class="font-semibold">9607378772</span>
          </a>

          <a
            href="tel:+917798202182"
            class="flex items-center gap-2.5 text-slate-300 hover:text-teal-300 transition-colors group"
          >
            <div
              class="w-8 h-8 rounded-lg bg-slate-800 border border-slate-700/80 flex items-center justify-center text-teal-400 group-hover:border-teal-500/50 transition-colors shrink-0"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
            </div>
            <span class="font-semibold">7798202182</span>
          </a>
        </div>
      </div>

      <!-- Col 4: Follow Us (lg: 3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">
          Follow Us
        </h4>
        <ul class="space-y-2 text-xs">
          {
            socialLinks.map((social) => (
              <li>
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-between py-1.5 px-2.5 rounded-lg bg-slate-900/80 hover:bg-slate-850 border border-slate-800 hover:border-teal-500/40 text-slate-300 hover:text-white transition-all group"
                >
                  <div class="flex items-center gap-2 min-w-0">
                    {social.type === "instagram" ? (
                      <span class="w-4 h-4 rounded text-pink-400 shrink-0 flex items-center justify-center">
                        <svg
                          class="w-3.5 h-3.5 fill-current"
                          viewBox="0 0 24 24"
                        >
                          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                        </svg>
                      </span>
                    ) : (
                      <span class="w-4 h-4 rounded text-red-500 shrink-0 flex items-center justify-center">
                        <svg
                          class="w-3.5 h-3.5 fill-current"
                          viewBox="0 0 24 24"
                        >
                          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                        </svg>
                      </span>
                    )}
                    <span class="font-medium text-slate-300 group-hover:text-white truncate">
                      {social.name}
                    </span>
                  </div>
                  <svg
                    class="w-3 h-3 text-slate-500 group-hover:text-teal-400 group-hover:translate-x-0.5 transition-all shrink-0 ml-1"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright & Back to Top -->
    <div
      class="mt-10 pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400"
    >
      <p>
        © {currentYear}
        <span class="text-slate-300 font-semibold">Healing Care Physio</span>.
        All rights reserved.
      </p>

      <a
        href="#"
        class="inline-flex items-center gap-1.5 text-slate-400 hover:text-teal-300 transition-colors"
        aria-label="Back to top"
      >
        <span>Back to Top</span>
        <svg
          class="w-3.5 h-3.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
        </svg>
      </a>
    </div>
  </div>
</footer>
