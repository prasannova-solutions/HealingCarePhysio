---
// SymptomNavigator.astro

const categories = [
  { id: "all", label: "All Care" },
  { id: "spine", label: "Spine & Neck" },
  { id: "joints", label: "Joints & Knees" },
  { id: "neuro", label: "Neuro Rehab" },
  { id: "sports", label: "Sports Rehab" },
  { id: "women-pediatric", label: "Specialized Care" },
];

const conditions = [
  {
    id: "back-pain",
    category: "spine",
    title: "Severe Back Pain & Sciatica",
    region: "Spine Care",
    image: "/SymptomNavigator/Severe Back Pain & Sciatica.jpg",
    description:
      "Specialized care for persistent back pain, nerve compression and sciatica.",
  },
  {
    id: "neck-pain",
    category: "spine",
    title: "Cervical Spondylosis & Neck Pain",
    region: "Neck Care",
    image: "/SymptomNavigator/Cervical Spondylosis & Neck Pain.jpg",
    description:
      "Targeted treatment for neck stiffness, radiating pain and posture concerns.",
  },
  {
    id: "knee-osteoarthritis",
    category: "joints",
    title: "Knee Pain & Osteoarthritis",
    region: "Joint Care",
    image: "/SymptomNavigator/Knee Pain & Osteoarthritis.jpeg",
    description:
      "Non-surgical rehabilitation focused on mobility, strength and pain relief.",
  },
  {
    id: "frozen-shoulder",
    category: "joints",
    title: "Frozen Shoulder & Rotator Cuff",
    region: "Shoulder Care",
    image: "/SymptomNavigator/Frozen Shoulder & Rotator Cuff.webp",
    description:
      "Restore shoulder mobility, strength and comfortable everyday movement.",
  },
  {
    id: "stroke-paralysis",
    category: "neuro",
    title: "Stroke & Hemiplegia Rehabilitation",
    region: "Neuro Rehabilitation",
    image: "/SymptomNavigator/Stroke & Hemiplegia Rehabilitation.jpg",
    description:
      "Structured rehabilitation focused on movement, balance and independence.",
  },
  {
    id: "sports-injuries",
    category: "sports",
    title: "Sports Injuries & Ligament Tears",
    region: "Sports Rehabilitation",
    image: "/SymptomNavigator/Sports Injuries & Ligament Tears.jpg",
    description:
      "Professional rehabilitation for athletes and active individuals.",
  },
  {
    id: "post-surgery-fracture",
    category: "sports",
    title: "Post-Surgery & Joint Replacement Rehab",
    region: "Post-Operative Care",
    image: "/SymptomNavigator/Post-Surgery & Total Joint Replacement Rehab.png",
    description:
      "Guided recovery after surgery, fractures and joint replacement.",
  },
  {
    id: "women-maternity",
    category: "women-pediatric",
    title: "Pre/Post-Natal & Women's Health Care",
    region: "Women's Health",
    image: "/SymptomNavigator/PrePost-Natal & Women's Health Care.jpg",
    description:
      "Personalized movement and wellness support for every stage of life.",
  },
  {
    id: "cardiac-pediatric",
    category: "women-pediatric",
    title: "Cardiac & Pediatric Developmental Care",
    region: "Specialized Care",
    image: "/SymptomNavigator/Cardiac Pediatric Developmental Care.jpg",
    description:
      "Gentle rehabilitation programs for cardiac recovery and child development.",
  },
];
---

<section
  id="conditions"
  class="relative overflow-hidden bg-[#f4fbfa] py-16 sm:py-20 lg:py-24"
>
  <!-- =========================================
       BACKGROUND
  ========================================== -->

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <!-- =========================================
         HEADER
    ========================================== -->

    <div class="mx-auto max-w-3xl text-center">

      <div
        class="inline-flex items-center gap-2 rounded-full border border-teal-200 bg-white/80 px-4 py-2"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal-400 opacity-60"
          ></span>

          <span
            class="relative inline-flex h-2 w-2 rounded-full bg-teal-600"
          ></span>
        </span>

        <span
          class="text-[10px] font-bold uppercase tracking-[0.16em] text-teal-800"
        >
          Conditions We Treat
        </span>
      </div>

      <h2
        class="mt-5 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl lg:text-5xl"
      >
        Find Care for What
        <span class="text-teal-700">You're Experiencing</span>
      </h2>

      <p
        class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base"
      >
        Explore the conditions we commonly help treat and discover
        personalized physiotherapy designed around your recovery.
      </p>

    </div>


    <!-- =========================================
         FILTERS
    ========================================== -->

    <div class="mt-10">

      <div
        id="condition-filters"
        class="flex gap-2 overflow-x-auto pb-3 sm:justify-center sm:flex-wrap sm:overflow-visible"
      >
        {
          categories.map((cat, index) => (
            <button
              type="button"
              data-category-btn={cat.id}
              class={`condition-filter-btn shrink-0 rounded-full px-4 py-2.5 text-xs font-semibold transition-all duration-300 ${
                index === 0
                  ? "active-filter bg-teal-700 text-white"
                  : "border border-slate-200 bg-white text-slate-600 hover:border-teal-300 hover:bg-teal-50 hover:text-teal-800"
              }`}
            >
              {cat.label}
            </button>
          ))
        }
      </div>

    </div>


    <!-- =========================================
         CAROUSEL HEADER + CONTROLS
    ========================================== -->

    <div
      class="mt-8 flex items-center justify-between gap-4 sm:mt-10"
    >

      <div>

        <p
          class="text-[10px] font-bold uppercase tracking-[0.18em] text-teal-700"
        >
          Explore Our Care
        </p>

        <p class="mt-1 text-sm text-slate-500">
          Swipe or use the arrows to explore.
        </p>

      </div>


      <!-- Arrow Controls -->

      <div class="flex items-center gap-2">

        <button
          id="conditions-prev"
          type="button"
          aria-label="Previous conditions"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 transition-all duration-300 hover:border-teal-500 hover:bg-teal-700 hover:text-white active:scale-95"
        >
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"
            />
          </svg>
        </button>


        <button
          id="conditions-next"
          type="button"
          aria-label="Next conditions"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 transition-all duration-300 hover:border-teal-500 hover:bg-teal-700 hover:text-white active:scale-95"
        >
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"
            />
          </svg>
        </button>

      </div>

    </div>


    <!-- =========================================
         HORIZONTAL CAROUSEL
    ========================================== -->

    <div class="relative mt-5">

      <!-- Edge fade desktop -->

      <div
        class="pointer-events-none absolute bottom-0 left-0 top-0 z-10 hidden w-10 bg-gradient-to-r from-[#f4fbfa] to-transparent lg:block"
      ></div>

      <div
        class="pointer-events-none absolute bottom-0 right-0 top-0 z-10 hidden w-16 bg-gradient-to-l from-[#f4fbfa] to-transparent lg:block"
      ></div>


      <div
        id="conditions-carousel"
        class="
          flex
          gap-4
          overflow-x-auto
          scroll-smooth
          pb-5
          snap-x
          snap-mandatory
          sm:gap-5
          lg:gap-6
        "
      >

        {
          conditions.map((item) => (

            <article
              data-condition-card
              data-cat={item.category}
              class="
                condition-card
                group
                relative
                flex
                w-[260px]
                min-w-[260px]
                snap-start
                flex-col
                overflow-hidden
                rounded-[22px]
                border
                border-slate-200
                bg-white
                transition-all
                duration-300
                hover:-translate-y-1
                hover:border-teal-300
                sm:w-[280px]
                sm:min-w-[280px]
                lg:w-[285px]
                lg:min-w-[285px]
              "
            >

              <!-- ================= IMAGE ================= -->

              <div
                class="relative h-[145px] overflow-hidden sm:h-[155px]"
              >

                <img
                  src={item.image}
                  alt={item.title}
                  loading="lazy"
                  class="
                    h-full
                    w-full
                    object-cover
                    transition-transform
                    duration-700
                    group-hover:scale-105
                  "
                />

                <!-- Image overlay -->

                <div
                  class="absolute inset-0 bg-gradient-to-t from-slate-950/50 via-transparent to-transparent"
                ></div>


                <!-- Region pill -->

                <span
                  class="
                    absolute
                    left-3
                    top-3
                    rounded-full
                    border
                    border-white/40
                    bg-white/95
                    px-2.5
                    py-1
                    text-[9px]
                    font-bold
                    uppercase
                    tracking-wider
                    text-teal-800
                  "
                >
                  {item.region}
                </span>

              </div>


              <!-- ================= CONTENT ================= -->

              <div class="flex flex-1 flex-col p-4 sm:p-5">

                <h3
                  class="
                    text-[15px]
                    font-bold
                    leading-snug
                    tracking-tight
                    text-slate-900
                    transition-colors
                    duration-300
                    group-hover:text-teal-700
                    sm:text-base
                  "
                >
                  {item.title}
                </h3>


                <p
                  class="
                    mt-2
                    text-xs
                    leading-relaxed
                    text-slate-500
                  "
                >
                  {item.description}
                </p>


                <!-- Bottom CTA -->

                <a
                  href="#appointment"
                  class="
                    mt-4
                    flex
                    items-center
                    justify-between
                    border-t
                    border-slate-100
                    pt-3
                    text-[11px]
                    font-bold
                    text-slate-700
                    transition-colors
                    hover:text-teal-700
                  "
                >

                  <span>Explore care options</span>

                  <span
                    class="
                      flex
                      h-7
                      w-7
                      items-center
                      justify-center
                      rounded-full
                      bg-teal-50
                      text-sm
                      text-teal-700
                      transition-all
                      duration-300
                      group-hover:translate-x-1
                      group-hover:bg-teal-700
                      group-hover:text-white
                    "
                  >
                    →
                  </span>

                </a>

              </div>

            </article>

          ))
        }

      </div>

    </div>


    <!-- =========================================
         BOTTOM HELP SECTION
    ========================================== -->

    <div
      class="
        relative
        mt-10
        overflow-hidden
        rounded-[28px]
        bg-slate-950
        p-6
        sm:mt-12
        sm:p-8
        lg:p-9
      "
    >

      <div
        class="
          relative
          flex
          flex-col
          gap-5
          lg:flex-row
          lg:items-center
          lg:justify-between
        "
      >

        <div class="max-w-2xl">

          <div
            class="
              flex
              items-center
              gap-2
              text-[10px]
              font-bold
              uppercase
              tracking-[0.16em]
              text-teal-400
            "
          >
            <span class="h-1.5 w-1.5 rounded-full bg-teal-400"></span>
            Need guidance?
          </div>


          <h3
            class="
              mt-2
              text-xl
              font-bold
              tracking-tight
              text-white
              sm:text-2xl
            "
          >
            Not sure which treatment is right for you?
          </h3>


          <p
            class="
              mt-2
              text-sm
              leading-relaxed
              text-slate-400
            "
          >
            Tell us what you're experiencing. Our physiotherapy team will
            help guide you toward the right next step.
          </p>

        </div>


        <a
          href="#appointment"
          class="
            group
            inline-flex
            shrink-0
            items-center
            justify-center
            gap-3
            rounded-xl
            bg-white
            px-6
            py-3.5
            text-xs
            font-bold
            text-slate-900
            transition-all
            duration-300
            hover:-translate-y-1
            hover:bg-teal-50
          "
        >

          Talk to Our Team

          <svg
            class="
              h-4
              w-4
              transition-transform
              duration-300
              group-hover:translate-x-1
            "
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 5l7 7m0 0l-7 7m7-7H3"
            />
          </svg>

        </a>

      </div>

    </div>

  </div>
</section>


<style>

  /* Hide scrollbars */

  #conditions-carousel::-webkit-scrollbar {
    display: none;
  }

  #conditions-carousel {
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }


  #condition-filters::-webkit-scrollbar {
    display: none;
  }

  #condition-filters {
    scrollbar-width: none;
  }


  /* Desktop mouse drag cursor */

  #conditions-carousel {
    cursor: grab;
  }

  #conditions-carousel.dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }


  /* Mobile cards show next card slightly */

  @media (max-width: 639px) {

    #conditions-carousel {
      padding-right: 2rem;
    }

  }


  /* Desktop breathing room */

  @media (min-width: 1024px) {

    #conditions-carousel {
      padding-left: 1rem;
      padding-right: 1rem;
    }

  }

</style>


<script>

  const carousel = document.getElementById(
    "conditions-carousel"
  );

  const prevButton = document.getElementById(
    "conditions-prev"
  );

  const nextButton = document.getElementById(
    "conditions-next"
  );

  const filterButtons = document.querySelectorAll(
    "[data-category-btn]"
  );

  const cards = document.querySelectorAll(
    "[data-condition-card]"
  );


  /* =========================================
     ARROW NAVIGATION
  ========================================== */

  function getScrollAmount() {

    if (window.innerWidth >= 1024) {
      return 310;
    }

    if (window.innerWidth >= 640) {
      return 300;
    }

    return 280;
  }


  nextButton?.addEventListener("click", () => {

    carousel?.scrollBy({
      left: getScrollAmount(),
      behavior: "smooth",
    });

  });


  prevButton?.addEventListener("click", () => {

    carousel?.scrollBy({
      left: -getScrollAmount(),
      behavior: "smooth",
    });

  });


  /* =========================================
     DESKTOP MOUSE DRAG
  ========================================== */

  let isDown = false;
  let startX = 0;
  let scrollLeft = 0;


  carousel?.addEventListener("mousedown", (event) => {

    isDown = true;

    carousel.classList.add("dragging");

    startX = event.pageX - carousel.offsetLeft;

    scrollLeft = carousel.scrollLeft;

  });


  carousel?.addEventListener("mouseleave", () => {

    isDown = false;

    carousel.classList.remove("dragging");

  });


  carousel?.addEventListener("mouseup", () => {

    isDown = false;

    carousel.classList.remove("dragging");

  });


  carousel?.addEventListener("mousemove", (event) => {

    if (!isDown) return;

    event.preventDefault();

    const x =
      event.pageX - carousel.offsetLeft;

    const walk =
      (x - startX) * 1.5;

    carousel.scrollLeft =
      scrollLeft - walk;

  });


  /* =========================================
     CATEGORY FILTER
  ========================================== */

  filterButtons.forEach((button) => {

    button.addEventListener("click", () => {

      const category =
        button.getAttribute("data-category-btn");


      /* Reset buttons */

      filterButtons.forEach((btn) => {

        btn.classList.remove(
          "active-filter",
          "bg-teal-700",
          "text-white"
        );

        btn.classList.add(
          "border",
          "border-slate-200",
          "bg-white",
          "text-slate-600"
        );

      });


      /* Active button */

      button.classList.add(
        "active-filter",
        "bg-teal-700",
        "text-white"
      );

      button.classList.remove(
        "border",
        "border-slate-200",
        "bg-white",
        "text-slate-600"
      );


      /* Filter cards */

      cards.forEach((card) => {

        const cardCategory =
          card.getAttribute("data-cat");


        if (
          category === "all" ||
          cardCategory === category
        ) {

          (card as HTMLElement).style.display =
            "flex";

        } else {

          (card as HTMLElement).style.display =
            "none";

        }

      });


      /* Return carousel to beginning */

      carousel?.scrollTo({
        left: 0,
        behavior: "smooth",
      });

    });

  });

</script>