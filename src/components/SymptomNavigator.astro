---
// SymptomNavigator.astro
// Interactive Conditions Directory & Body Symptom Navigator

const categories = [
  { id: "all", label: "All Conditions" },
  { id: "spine", label: "Spine & Neck" },
  { id: "joints", label: "Joints & Knees" },
  { id: "neuro", label: "Neurological & Stroke" },
  { id: "sports", label: "Sports & Post-Surgery" },
  { id: "women-pediatric", label: "Women & Specialized Care" },
];

const conditions = [
  {
    id: "back-pain",
    category: "spine",
    title: "Severe Back Pain & Sciatica",
    region: "Lumbar Spine",
    symptoms: ["Shooting leg pain", "Numbness", "Morning stiffness", "Inability to bend"],
    recommendedTherapies: ["Robotic Traction", "Chiropractic Adjustment", "Dry Needling"],
    recoveryTime: "2 to 6 Weeks",
    description:
      "Precision spinal decompression and gentle vertebral realignment to relieve pinched nerve roots, herniated discs, and chronic lower back spasms.",
  },
  {
    id: "neck-pain",
    category: "spine",
    title: "Cervical Spondylosis & Neck Pain",
    region: "Cervical Spine",
    symptoms: ["Radiating shoulder ache", "Tension headaches", "Dizziness", "Restricted rotation"],
    recommendedTherapies: ["Manual Mobilization", "Laser Therapy", "Ergonomic Posture Correction"],
    recoveryTime: "1 to 4 Weeks",
    description:
      "Targeted cervical decompression and deep soft-tissue release to eliminate tension headaches, numbness down the arm, and stiff neck posture.",
  },
  {
    id: "knee-osteoarthritis",
    category: "joints",
    title: "Knee Pain & Osteoarthritis",
    region: "Knee Joint",
    symptoms: ["Joint clicking", "Difficulty climbing stairs", "Swelling", "Morning rigidity"],
    recommendedTherapies: ["Matrix Rhythm Therapy", "Strengthening Protocols", "Electro-Combo Therapy"],
    recoveryTime: "3 to 8 Weeks",
    description:
      "Advanced non-surgical cartilage preservation protocols, muscular stabilization, and pain relief designed to delay or avoid knee replacement surgery.",
  },
  {
    id: "frozen-shoulder",
    category: "joints",
    title: "Frozen Shoulder & Rotator Cuff",
    region: "Shoulder",
    symptoms: ["Sharp reaching pain", "Sleep disturbance", "Severe motion loss", "Weak lift"],
    recommendedTherapies: ["Advanced Dry Needling", "Joint Capsule Stretching", "Laser Therapy"],
    recoveryTime: "4 to 8 Weeks",
    description:
      "Gentle capsular distension techniques and neuromuscular activation to restore 360-degree pain-free shoulder elevation and reaching power.",
  },
  {
    id: "stroke-paralysis",
    category: "neuro",
    title: "Stroke & Hemiplegia Rehabilitation",
    region: "Neurological System",
    symptoms: ["One-sided weakness", "Balance loss", "Gait disturbance", "Spasticity"],
    recommendedTherapies: ["In-Patient Residential Rehab", "Gait Training", "Neuro-Muscular Facilitation"],
    recoveryTime: "Custom Pathway",
    description:
      "Comprehensive neuro-plasticity training, parallel-bar gait retraining, and residential in-patient therapy to help stroke survivors walk and live independently.",
  },
  {
    id: "sports-injuries",
    category: "sports",
    title: "Sports Injuries & Ligament Tears (ACL/MCL)",
    region: "Musculoskeletal",
    symptoms: ["Sudden joint giving way", "Acute swelling", "Muscle tears", "Loss of explosive power"],
    recommendedTherapies: ["Sports Medicine Triage", "Strength & Conditioning", "Return-to-Play Testing"],
    recoveryTime: "4 to 12 Weeks",
    description:
      "Led by Dr. Vrishabh (MPT Sports Medicine) — high-performance athletic rehabilitation, biomechanics correction, and agility reconditioning for athletes.",
  },
  {
    id: "post-surgery-fracture",
    category: "sports",
    title: "Post-Surgery & Total Joint Replacement Rehab",
    region: "Post-Operative",
    symptoms: ["Post-cast stiffness", "Surgical muscle atrophy", "Scar tissue tightness", "Limping"],
    recommendedTherapies: ["Post-Op Mobility Protocols", "Continuous Passive Motion", "Gait Retraining"],
    recoveryTime: "6 to 12 Weeks",
    description:
      "Early mobilization and structured progressive loading after knee/hip replacement, fracture fixation, or ligament reconstruction surgery.",
  },
  {
    id: "women-maternity",
    category: "women-pediatric",
    title: "Pre/Post-Natal & Women's Health Care",
    region: "Pelvic & Core",
    symptoms: ["Pregnancy pelvic girdle pain", "Postpartum diastasis recti", "Menopause joint aches"],
    recommendedTherapies: ["Clinical Pilates", "Pelvic Floor Strengthening", "Certified Diet Planning"],
    recoveryTime: "Personalized",
    description:
      "Under Dr. Tejaswini Kasar (BPT, Certified Dietitian) with dedicated private batches for women — safe trimester-safe exercise, core restoration, and menopause care.",
  },
  {
    id: "cardiac-pediatric",
    category: "women-pediatric",
    title: "Cardiac & Pediatric Developmental Care",
    region: "Cardio / Pediatric",
    symptoms: ["Post-cardiac fatigue", "Child motor delay", "Postural deviations in kids"],
    recommendedTherapies: ["Monitored Cardio Reconditioning", "Pediatric Motor Milestone Therapy"],
    recoveryTime: "Ongoing Monitoring",
    description:
      "Gentle cardiopulmonary endurance building for recovering cardiac patients and developmental motor therapy for growing children.",
  },
];
---

<section
  id="conditions"
  class="relative overflow-hidden bg-[#f0f9f8] py-20 sm:py-24 lg:py-32"
>
  <!-- Background Highlights -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div
      class="absolute -right-40 top-20 h-96 w-96 rounded-full bg-teal-100/60 blur-3xl"
    >
    </div>
    <div
      class="absolute -left-40 bottom-20 h-96 w-96 rounded-full bg-cyan-100/50 blur-3xl"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mx-auto max-w-3xl text-center">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-teal-200 bg-white/90 px-4 py-1.5 shadow-xs backdrop-blur"
      >
        <span class="h-2 w-2 rounded-full bg-teal-600"></span>
        <span
          class="text-xs font-bold uppercase tracking-wider text-teal-900"
        >
          Clinical Directory & Symptom Navigator
        </span>
      </div>

      <h2
        class="mt-5 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl"
      >
        Conditions We Treat with
        <span class="text-teal-700">Non-Surgical Precision</span>
      </h2>

      <p class="mt-4 text-base sm:text-lg text-slate-600">
        Filter by body region or condition to see our specialized clinical
        pathway and recommended therapies.
      </p>
    </div>

    <!-- Category Filter Tabs -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-2.5 sm:gap-3">
      {
        categories.map((cat, idx) => (
          <button
            type="button"
            data-category-btn={cat.id}
            class={`condition-filter-btn rounded-full px-5 py-2.5 text-xs sm:text-sm font-semibold transition-all duration-300 ${
              idx === 0
                ? "active-btn bg-teal-700 text-white shadow-md shadow-teal-700/20"
                : "bg-white text-slate-700 hover:bg-teal-50 hover:text-teal-900 border border-slate-200/80"
            }`}
          >
            {cat.label}
          </button>
        ))
      }
    </div>

    <!-- Condition Cards Grid -->
    <div
      id="conditions-grid"
      class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        conditions.map((item) => (
          <div
            data-condition-card
            data-cat={item.category}
            class="group flex flex-col justify-between rounded-3xl border border-slate-200/90 bg-white p-6 shadow-[0_10px_30px_rgba(15,118,110,0.04)] transition-all duration-300 hover:-translate-y-1 hover:border-teal-400 hover:shadow-[0_20px_40px_rgba(15,118,110,0.12)]"
          >
            <div>
              <!-- Top Row -->
              <div class="flex items-center justify-between gap-2">
                <span class="inline-flex items-center rounded-lg bg-teal-50 px-3 py-1 text-xs font-bold text-teal-800 border border-teal-100">
                  {item.region}
                </span>
                <span class="text-[11px] font-medium text-slate-400">
                  Avg: {item.recoveryTime}
                </span>
              </div>

              <!-- Title -->
              <h3 class="mt-4 text-xl font-bold text-slate-900 group-hover:text-teal-800 transition-colors">
                {item.title}
              </h3>

              <p class="mt-2.5 text-xs sm:text-sm leading-relaxed text-slate-600">
                {item.description}
              </p>

              <!-- Common Symptoms -->
              <div class="mt-4 pt-4 border-t border-slate-100">
                <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">
                  Key Symptoms:
                </p>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {item.symptoms.map((symp) => (
                    <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-700">
                      • {symp}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Recommended Treatments & CTA -->
            <div class="mt-6 pt-4 border-t border-slate-100">
              <p class="text-[11px] font-bold uppercase tracking-wider text-teal-800">
                Recommended Protocols:
              </p>
              <div class="mt-2 flex flex-wrap gap-1.5">
                {item.recommendedTherapies.map((tx) => (
                  <span class="rounded-full bg-teal-50/80 border border-teal-200/60 px-2.5 py-0.5 text-[11px] font-semibold text-teal-900">
                    {tx}
                  </span>
                ))}
              </div>

              <a
                href="#appointment"
                class="mt-5 flex w-full items-center justify-center gap-2 rounded-xl bg-slate-900 py-2.5 text-xs font-bold text-white transition group-hover:bg-teal-700"
              >
                <span>Consult for This Condition</span>
                <svg
                  class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M14 5l7 7m0 0l-7 7m7-7H3"
                  />
                </svg>
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Quick Help Banner -->
    <div
      class="mt-14 rounded-3xl bg-gradient-to-r from-teal-800 to-cyan-900 p-8 sm:p-10 text-white shadow-xl"
    >
      <div
        class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between"
      >
        <div>
          <h4 class="text-xl sm:text-2xl font-extrabold text-white">
            Not sure what is causing your pain?
          </h4>
          <p class="mt-2 text-sm text-teal-100 max-w-xl">
            Our specialists conduct a comprehensive 45-minute musculoskeletal,
            neurological, and postural assessment before prescribing any
            treatment.
          </p>
        </div>

        <a
          href="tel:9607378772"
          class="inline-flex shrink-0 items-center justify-center gap-2 rounded-2xl bg-white px-6 py-3.5 text-xs sm:text-sm font-bold text-slate-900 shadow-md transition hover:bg-teal-50 hover:scale-105"
        >
          <svg class="h-4 w-4 text-teal-700" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"/>
          </svg>
          <span>Speak to Dr. Kasar Directly</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // Filter Functionality
  const filterButtons = document.querySelectorAll("[data-category-btn]");
  const cards = document.querySelectorAll("[data-condition-card]");

  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const cat = btn.getAttribute("data-category-btn");

      // Update button active styles
      filterButtons.forEach((b) => {
        b.classList.remove("bg-teal-700", "text-white", "shadow-md", "shadow-teal-700/20");
        b.classList.add("bg-white", "text-slate-700", "border", "border-slate-200/80");
      });
      btn.classList.add("bg-teal-700", "text-white", "shadow-md", "shadow-teal-700/20");
      btn.classList.remove("bg-white", "text-slate-700", "border", "border-slate-200/80");

      // Filter cards
      cards.forEach((card) => {
        const cardCat = card.getAttribute("data-cat");
        if (cat === "all" || cardCat === cat) {
          (card as HTMLElement).style.display = "flex";
        } else {
          (card as HTMLElement).style.display = "none";
        }
      });
    });
  });
</script>
