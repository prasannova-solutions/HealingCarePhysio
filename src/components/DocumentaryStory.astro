---
// DocumentaryStory.astro
// Premium Hospital Documentary / Milestone Section

const documentaries = [
  {
    id: "5-year-milestone",
    eyebrow: "THE JOURNEY",
    title: "5 Years of Healing, Trust & Transformation",
    shortTitle: "5 Years of Healing",
    subtitle:
      "From a college vision to a trusted regional rehabilitation centre.",
    videoId: "TTXPW33yOOI",
    youtubeUrl: "https://www.youtube.com/watch?v=TTXPW33yOOI",
    badge: "5 Year Milestone",
    stat: "10,000+",
    statLabel: "Patients Guided",
  },
  {
    id: "anniversary-celebration",
    eyebrow: "THE NEXT CHAPTER",
    title: "One Year of Hospital & Matrix Physio Gym",
    shortTitle: "Hospital + Matrix Gym",
    subtitle:
      "Where clinical rehabilitation and advanced fitness come together.",
    videoId: "JyACGjn3RvA",
    youtubeUrl: "https://www.youtube.com/watch?v=JyACGjn3RvA",
    badge: "Anniversary Special",
    stat: "01",
    statLabel: "Year Anniversary",
  },
];

const featured = documentaries[0];
const secondary = documentaries[1];
---

<section
  id="our-story"
  class="relative overflow-hidden bg-[#091018] py-16 text-white sm:py-20 lg:py-24"
>
  <!-- Subtle Premium Background -->
  <div class="pointer-events-none absolute inset-0">
    <div
      class="absolute left-1/2 top-0 h-[500px] w-[800px] -translate-x-1/2 rounded-full bg-teal-500/[0.05] blur-[100px]"
    >
    </div>

    <div
      class="absolute inset-0 opacity-[0.025]"
      style="
        background-image: linear-gradient(
            rgba(255,255,255,0.7) 1px,
            transparent 1px
          ),
          linear-gradient(90deg, rgba(255,255,255,0.7) 1px, transparent 1px);
        background-size: 60px 60px;
      "
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- =====================================================
         COMPACT EDITORIAL HEADER
    ====================================================== -->

    <div
      class="grid gap-8 border-b border-white/[0.08] pb-10 lg:grid-cols-[1fr_1.25fr] lg:items-end lg:pb-12"
    >
      <!-- Left -->
      <div>
        <div class="mb-5 flex items-center gap-3">
          <span class="h-px w-8 bg-teal-400"></span>

          <span
            class="text-[10px] font-bold uppercase tracking-[0.25em] text-teal-300 sm:text-xs"
          >
            Our Story
          </span>
        </div>

        <h2
          class="max-w-xl text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl"
        >
          Built with purpose.
          <span class="block text-slate-400"> Proven through recovery. </span>
        </h2>
      </div>

      <!-- Right -->
      <div class="lg:pb-1">
        <p
          class="max-w-2xl text-sm leading-relaxed text-slate-400 sm:text-base"
        >
          What started as a vision during college has grown into a trusted
          rehabilitation centre serving patients across Gadhinglaj, Kolhapur and
          the Karnataka border.
        </p>
      </div>
    </div>

    <!-- =====================================================
         MAIN STORY EXPERIENCE
    ====================================================== -->

    <div class="mt-10 grid gap-5 lg:grid-cols-[1.55fr_0.85fr] lg:gap-6">
      <!-- ==========================================
           FEATURED DOCUMENTARY
      =========================================== -->

      <article
        class="group relative overflow-hidden rounded-[24px] border border-white/[0.08] bg-[#0d1721]"
      >
        <!-- Video -->
        <div class="relative aspect-video overflow-hidden bg-black">
          <!-- Label -->
          <div
            class="absolute left-4 top-4 z-10 flex items-center gap-2 rounded-full border border-white/[0.12] bg-black/60 px-3 py-1.5"
          >
            <span class="relative flex h-2 w-2">
              <span
                class="absolute inline-flex h-full w-full animate-ping rounded-full bg-red-400 opacity-60"
              ></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-red-400"
              ></span>
            </span>

            <span
              class="text-[10px] font-bold uppercase tracking-[0.16em] text-white"
            >
              Documentary
            </span>
          </div>

          <!-- YouTube -->
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${featured.videoId}?rel=0&modestbranding=1`}
            title={featured.title}
            class="absolute inset-0 h-full w-full border-0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"></iframe>
        </div>

        <!-- Content -->
        <div class="p-5 sm:p-7">
          <div
            class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[10px] font-bold uppercase tracking-[0.16em]"
          >
            <span class="text-teal-300">
              {featured.eyebrow}
            </span>

            <span class="h-1 w-1 rounded-full bg-slate-600"></span>

            <span class="text-slate-500">
              {featured.badge}
            </span>
          </div>

          <div class="mt-4 grid gap-5 sm:grid-cols-[1fr_auto] sm:items-end">
            <div>
              <h3
                class="max-w-2xl text-xl font-bold leading-tight text-white sm:text-2xl lg:text-3xl"
              >
                {featured.title}
              </h3>

              <p class="mt-3 max-w-xl text-sm leading-relaxed text-slate-400">
                {featured.subtitle}
              </p>
            </div>

            <!-- Stat -->
            <div class="border-l border-white/[0.08] pl-5 sm:min-w-[120px]">
              <div
                class="text-2xl font-bold tracking-tight text-teal-300 sm:text-3xl"
              >
                {featured.stat}
              </div>

              <div
                class="mt-1 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500"
              >
                {featured.statLabel}
              </div>
            </div>
          </div>

          <!-- Minimal Footer -->
          <div
            class="mt-6 flex items-center justify-between border-t border-white/[0.07] pt-5"
          >
            <span class="text-xs text-slate-500">
              Healing Care Physio Documentary
            </span>

            <a
              href={featured.youtubeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group/link inline-flex items-center gap-2 text-xs font-bold text-teal-300 transition hover:text-teal-200"
            >
              Watch on YouTube

              <svg
                class="h-4 w-4 transition-transform group-hover/link:translate-x-1"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
      </article>

      <!-- ==========================================
           RIGHT COLUMN
      =========================================== -->

      <div class="flex flex-col gap-5">
        <!-- Secondary Documentary -->
        <article
          class="group overflow-hidden rounded-[24px] border border-white/[0.08] bg-[#0d1721]"
        >
          <!-- Video -->
          <div class="relative aspect-video overflow-hidden bg-black">
            <div
              class="absolute left-3 top-3 z-10 rounded-full border border-white/[0.1] bg-black/60 px-3 py-1 text-[9px] font-bold uppercase tracking-[0.15em] text-white"
            >
              {secondary.badge}
            </div>

            <iframe
              src={`https://www.youtube-nocookie.com/embed/${secondary.videoId}?rel=0&modestbranding=1`}
              title={secondary.title}
              class="absolute inset-0 h-full w-full border-0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"></iframe>
          </div>

          <!-- Content -->
          <div class="p-5">
            <div class="flex items-start justify-between gap-4">
              <div>
                <span
                  class="text-[10px] font-bold uppercase tracking-[0.18em] text-teal-300"
                >
                  {secondary.eyebrow}
                </span>

                <h3
                  class="mt-2 text-lg font-bold leading-snug text-white sm:text-xl"
                >
                  {secondary.shortTitle}
                </h3>

                <p
                  class="mt-2 text-xs leading-relaxed text-slate-400 sm:text-sm"
                >
                  {secondary.subtitle}
                </p>
              </div>

              <div class="shrink-0 text-right">
                <div class="text-xl font-bold text-teal-300">
                  {secondary.stat}
                </div>

                <div
                  class="text-[8px] font-bold uppercase tracking-wider text-slate-500"
                >
                  Year
                </div>
              </div>
            </div>

            <a
              href={secondary.youtubeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-2 text-xs font-bold text-teal-300 transition hover:text-white"
            >
              View Anniversary Film
              <span>↗</span>
            </a>
          </div>
        </article>

        <!-- Founder Philosophy -->
        <div
          class="relative flex flex-1 flex-col justify-between overflow-hidden rounded-[24px] border border-teal-400/[0.12] bg-gradient-to-br from-teal-500/[0.09] via-[#0d1721] to-[#0d1721] p-5 sm:p-6"
        >
          <!-- Quote Icon -->
          <div
            class="absolute right-5 top-3 select-none text-7xl font-serif leading-none text-teal-400/[0.08]"
          >
            “
          </div>

          <div>
            <div class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-teal-400"></span>

              <span
                class="text-[10px] font-bold uppercase tracking-[0.18em] text-teal-300"
              >
                Our Mission
              </span>
            </div>

            <blockquote
              class="relative mt-4 max-w-xl text-base font-medium leading-relaxed text-slate-200 sm:text-lg"
            >
              “Our goal has always been simple — make advanced, scientific
              physiotherapy accessible to people who need it and help them
              return to independent living.”
            </blockquote>
          </div>

          <div
            class="mt-6 flex items-center justify-between gap-4 border-t border-white/[0.07] pt-4"
          >
            <div>
              <p class="text-xs font-bold text-white">
                Dr. Vrishabh & Dr. Tejaswini Kasar
              </p>

              <p class="mt-1 text-[10px] text-slate-500">
                Founders · Healing Care Physio
              </p>
            </div>

            <div
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-teal-400/20 bg-teal-400/10 text-teal-300"
            >
              <svg
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- =====================================================
         BOTTOM TRUST STRIP
    ====================================================== -->

    <div
      class="mt-6 grid divide-y divide-white/[0.07] overflow-hidden rounded-2xl border border-white/[0.08] bg-white/[0.025] sm:grid-cols-3 sm:divide-x sm:divide-y-0"
    >
      <div class="px-5 py-4 sm:px-6">
        <div
          class="text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500"
        >
          Built From
        </div>

        <div class="mt-1 text-sm font-semibold text-slate-200">
          A Vision Started in College
        </div>
      </div>

      <div class="px-5 py-4 sm:px-6">
        <div
          class="text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500"
        >
          Serving
        </div>

        <div class="mt-1 text-sm font-semibold text-slate-200">
          Maharashtra & Karnataka
        </div>
      </div>

      <a
        href="https://www.youtube.com/@healing_care_physio/videos"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center justify-between px-5 py-4 transition hover:bg-white/[0.04] sm:px-6"
      >
        <div>
          <div
            class="text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500"
          >
            See More
          </div>

          <div class="mt-1 text-sm font-semibold text-teal-300">
            Our Video Stories
          </div>
        </div>

        <svg
          class="h-4 w-4 text-teal-300 transition-transform group-hover:translate-x-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
