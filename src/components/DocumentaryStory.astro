---
// DocumentaryStory.astro
// 5-Year Journey, Hospital & Gym Anniversary, and Founder Mission

const documentaries = [
  {
    id: "5-year-milestone",
    title: "5 Years of Healing Care & Trust",
    subtitle: "From a Vision in College to Over 10,000 Lives Transformed",
    duration: "Documentary Feature",
    videoId: "TTXPW33yOOI",
    youtubeUrl: "https://www.youtube.com/watch?v=TTXPW33yOOI",
    badge: "5 Year Milestone",
    highlight: "10,000+ Patients Recovered",
    description:
      "Dr. Vrishabh and Dr. Tejaswini reflect on their 5-year journey of bringing evidence-based, world-class physiotherapy and rehabilitation to Gadhinglaj, Kolhapur, and Karnataka border regions.",
    keyPoints: [
      "College ambition brought to reality in rural Maharashtra",
      "Over 10,000 patients successfully guided to pain-free independence",
      "Expanding from local outpatient care to a specialized residential hospital",
    ],
  },
  {
    id: "anniversary-celebration",
    title: "1st Anniversary: Hospital & Matrix Gym",
    subtitle: "A New Benchmark for Integrated Medical Rehabilitation & Fitness",
    duration: "Anniversary Special",
    videoId: "JyACGjn3RvA",
    youtubeUrl: "https://www.youtube.com/watch?v=JyACGjn3RvA",
    badge: "1 Year Anniversary",
    highlight: "Hospital & Medical Gym",
    description:
      "Celebrating the milestone of launching our full-fledged Residential Rehabilitation Hospital and the advanced Matrix Physio Gym — bridging medical recovery and preventive athletic health.",
    keyPoints: [
      "In-patient residential care facility for distant patients",
      "Matrix Physio Gym with advanced clinical recovery machines",
      "Dedicated wellness facilities including steam bath & women's batches",
    ],
  },
];
---

<section
  id="our-story"
  class="relative overflow-hidden bg-[#0a111a] py-20 sm:py-28 lg:py-32 text-white"
>
  <!-- Background Glow & Grid Accents -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div
      class="absolute -left-32 top-1/4 h-96 w-96 rounded-full bg-teal-600/10 blur-[120px]"
    >
    </div>
    <div
      class="absolute -right-32 bottom-1/4 h-[450px] w-[450px] rounded-full bg-cyan-500/10 blur-[140px]"
    >
    </div>
    <div
      class="absolute inset-0 bg-[radial-gradient(#14b8a6_1px,transparent_1px)] [background-size:32px_32px] opacity-[0.04]"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header Section -->
    <div class="max-w-3xl">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-teal-500/30 bg-teal-950/60 px-4 py-1.5 backdrop-blur-md"
      >
        <span class="h-2 w-2 rounded-full bg-teal-400 animate-pulse"></span>
        <span class="text-xs font-bold uppercase tracking-widest text-teal-300">
          Our 5-Year Milestone & Vision
        </span>
      </div>

      <h2
        class="mt-6 text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl leading-[1.12]"
      >
        Built on Purpose. <br />
        <span
          class="bg-gradient-to-r from-teal-300 via-cyan-300 to-emerald-400 bg-clip-text text-transparent"
        >
          Proven by 10,000+ Recoveries.
        </span>
      </h2>

      <p class="mt-5 text-base sm:text-lg leading-relaxed text-slate-300">
        Ever since college, Dr. Vrishabh and Dr. Tejaswini envisioned bringing
        advanced, non-surgical physical medicine to Gadhinglaj. Today, Healing
        Care Physio stands as a regional beacon of hope for patients across
        Maharashtra and Karnataka.
      </p>
    </div>

    <!-- Video Showcase Grid -->
    <div class="mt-14 grid gap-8 lg:grid-cols-2 lg:gap-10">
      {
        documentaries.map((doc) => (
          <div class="group relative flex flex-col justify-between overflow-hidden rounded-[28px] border border-slate-800/80 bg-slate-900/80 p-6 sm:p-8 backdrop-blur-xl transition duration-500 hover:border-teal-500/50 hover:shadow-[0_20px_50px_rgba(13,148,136,0.15)]">
            <!-- Top Badges -->
            <div class="flex items-center justify-between gap-3">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-teal-500/10 border border-teal-500/20 px-3 py-1 text-xs font-semibold text-teal-300">
                <svg
                  class="h-3.5 w-3.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                {doc.badge}
              </span>
              <span class="text-xs font-medium text-slate-400">
                {doc.duration}
              </span>
            </div>

            <!-- YouTube Video Embed Container -->
            <div class="relative mt-6 aspect-video w-full overflow-hidden rounded-2xl border border-slate-800 bg-slate-950 shadow-inner">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${doc.videoId}?rel=0&modestbranding=1`}
                title={doc.title}
                class="h-full w-full border-0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              />
            </div>

            <!-- Details -->
            <div class="mt-6 flex-1">
              <h3 class="text-xl sm:text-2xl font-bold text-white group-hover:text-teal-300 transition-colors">
                {doc.title}
              </h3>
              <p class="mt-1 text-sm font-semibold text-teal-400/90">
                {doc.subtitle}
              </p>
              <p class="mt-4 text-sm leading-relaxed text-slate-300">
                {doc.description}
              </p>

              <!-- Key Takeaways -->
              <ul class="mt-5 space-y-2.5 border-t border-slate-800/80 pt-5">
                {doc.keyPoints.map((point) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-300">
                    <span class="mt-1 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-teal-500/20 text-teal-300">
                      ✓
                    </span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Action Button -->
            <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between">
              <span class="text-xs font-medium text-slate-400">
                Watch full on YouTube
              </span>
              <a
                href={doc.youtubeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-xl bg-teal-600/20 px-4 py-2 text-xs font-bold text-teal-300 border border-teal-500/30 transition hover:bg-teal-500 hover:text-slate-950"
              >
                <span>Open Video</span>
                <svg
                  class="h-3.5 w-3.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  />
                </svg>
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Trust Quote / Philosophy Bar -->
    <div
      class="mt-12 rounded-2xl border border-slate-800 bg-gradient-to-r from-slate-900 via-teal-950/40 to-slate-900 p-6 sm:p-8"
    >
      <div
        class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between"
      >
        <div class="flex items-start gap-4">
          <div
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-teal-500/20 border border-teal-500/30 text-teal-300 font-bold text-xl"
          >
            “
          </div>
          <div>
            <blockquote
              class="text-sm sm:text-base font-medium text-slate-200 italic"
            >
              "Our primary focus has always remained steadfast: providing
              genuine, scientific, and compassionate physiotherapy to patients
              across Kolhapur and Karnataka so they can regain total
              independence without surgery."
            </blockquote>
            <p class="mt-2 text-xs font-semibold text-teal-400">
              — Dr. Tejaswini Kasar (BPT, Certified Clinical Dietitian) & Dr.
              Vrishabh Kasar (MPT Sports Medicine)
            </p>
          </div>
        </div>

        <a
          href="https://www.youtube.com/@healing_care_physio/videos"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-red-600/90 px-5 py-3 text-xs font-bold text-white shadow-lg transition hover:bg-red-500 hover:scale-[1.02]"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
            <path
              d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
            ></path>
          </svg>
          <span>Explore YouTube Channel</span>
        </a>
      </div>
    </div>
  </div>
</section>
