---
// Navbar Component for Healing Care Physio
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white/85 backdrop-blur-md border-b border-teal-100/80 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
            <!-- Brand / Logo -->
            <a href="#" class="flex items-center gap-3 group focus:outline-hidden">
                <div class="relative w-11 h-11 sm:w-12 sm:h-12 rounded-xl overflow-hidden bg-white shadow-xs border border-teal-100 flex items-center justify-center p-1 group-hover:scale-105 group-hover:border-teal-300 transition-all duration-200">
                    <img 
                        src="/logo_.jpg" 
                        alt="Healing Care Physio Logo" 
                        class="w-full h-full object-contain"
                    />
                </div>
                <div class="flex flex-col">
                    <span class="text-lg sm:text-xl font-extrabold tracking-tight text-slate-900 leading-tight group-hover:text-teal-700 transition-colors">
                        Healing Care
                    </span>
                    <span class="text-[10px] sm:text-xs font-bold uppercase tracking-widest text-teal-600">
                        Physiotherapy Clinic
                    </span>
                </div>
            </a>

            <!-- Desktop Navigation Links (Visible on lg screens and up) -->
            <nav class="hidden lg:flex items-center gap-1 xl:gap-1.5">
                <a 
                    href="#conditions" 
                    class="px-3 py-1.5 text-xs xl:text-sm font-semibold text-slate-700 hover:text-teal-700 rounded-full hover:bg-teal-50/80 transition-colors"
                >
                    Conditions
                </a>
                <a 
                    href="#treatments" 
                    class="px-3 py-1.5 text-xs xl:text-sm font-semibold text-slate-700 hover:text-teal-700 rounded-full hover:bg-teal-50/80 transition-colors"
                >
                    Treatments
                </a>
                <a 
                    href="#approach" 
                    class="px-3 py-1.5 text-xs xl:text-sm font-semibold text-slate-700 hover:text-teal-700 rounded-full hover:bg-teal-50/80 transition-colors"
                >
                    5-Stage Approach
                </a>
                <a 
                    href="#residential-hospital" 
                    class="px-3 py-1.5 text-xs xl:text-sm font-semibold text-slate-700 hover:text-teal-700 rounded-full hover:bg-teal-50/80 transition-colors"
                >
                    Hospital Stay
                </a>
                <a 
                    href="#matrix-gym" 
                    class="px-3 py-1.5 text-xs xl:text-sm font-semibold text-slate-700 hover:text-teal-700 rounded-full hover:bg-teal-50/80 transition-colors"
                >
                    Matrix Gym
                </a>
                <a 
                    href="#our-story" 
                    class="px-3 py-1.5 text-xs xl:text-sm font-semibold text-slate-700 hover:text-teal-700 rounded-full hover:bg-teal-50/80 transition-colors"
                >
                    5-Yr Story
                </a>
                <a 
                    href="#care-team" 
                    class="px-3 py-1.5 text-xs xl:text-sm font-semibold text-slate-700 hover:text-teal-700 rounded-full hover:bg-teal-50/80 transition-colors"
                >
                    Doctors
                </a>
                <a 
                    href="#patient-stories" 
                    class="px-3 py-1.5 text-xs xl:text-sm font-semibold text-slate-700 hover:text-teal-700 rounded-full hover:bg-teal-50/80 transition-colors"
                >
                    Reviews
                </a>
            </nav>

            <!-- Desktop Right Actions (Visible on lg screens) -->
            <div class="hidden lg:flex items-center gap-2.5 xl:gap-3">
                <!-- Phone Call Quick Action -->
                <a 
                    href="tel:9607378772" 
                    class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-700 bg-slate-100 hover:bg-teal-50 hover:text-teal-700 px-3 py-2 rounded-full border border-slate-200/80 transition-all duration-200"
                >
                    <svg class="w-3.5 h-3.5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.986.836l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                    </svg>
                    <span>9607378772</span>
                </a>

                <!-- Primary Book Appointment CTA -->
                <a 
                    href="#appointment" 
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold shadow-md shadow-teal-700/20 hover:shadow-lg hover:shadow-teal-700/30 hover:-translate-y-0.5 transition-all duration-200"
                >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    <span>Book Consult</span>
                </a>
            </div>

            <!-- Mobile & Tablet Controls (Below lg breakpoint) -->
            <div class="flex items-center gap-2 sm:gap-3 lg:hidden">
                <button 
                    id="mobile-menu-btn" 
                    type="button" 
                    aria-label="Toggle navigation menu"
                    aria-expanded="false"
                    class="p-2 text-slate-700 hover:text-teal-700 hover:bg-teal-50 rounded-lg transition-colors focus:outline-hidden cursor-pointer"
                >
                    <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                    <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>

                <a 
                    href="#appointment" 
                    class="inline-flex items-center gap-1.5 px-3.5 sm:px-4 py-2 rounded-full bg-[#0D9488] hover:bg-[#0F766E] text-white text-xs sm:text-sm font-bold shadow-xs transition-all"
                >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    <span>Book</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Mobile / Tablet Drawer Menu -->
    <div id="mobile-menu" class="hidden lg:hidden border-t border-teal-100 bg-white/95 backdrop-blur-xl px-4 pt-3 pb-6 space-y-1.5 shadow-xl transition-all duration-200">
        <a 
            href="#conditions" 
            class="mobile-nav-link flex items-center justify-between px-4 py-2.5 rounded-xl text-base font-semibold text-slate-800 hover:bg-teal-50 hover:text-teal-700 transition-colors"
        >
            <span>Conditions & Symptoms</span>
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
        </a>
        <a 
            href="#treatments" 
            class="mobile-nav-link flex items-center justify-between px-4 py-2.5 rounded-xl text-base font-semibold text-slate-800 hover:bg-teal-50 hover:text-teal-700 transition-colors"
        >
            <span>Treatments & Modalities</span>
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
        </a>
        <a 
            href="#approach" 
            class="mobile-nav-link flex items-center justify-between px-4 py-2.5 rounded-xl text-base font-semibold text-slate-800 hover:bg-teal-50 hover:text-teal-700 transition-colors"
        >
            <span>Our 5-Stage Approach</span>
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
        </a>
        <a 
            href="#residential-hospital" 
            class="mobile-nav-link flex items-center justify-between px-4 py-2.5 rounded-xl text-base font-semibold text-slate-800 hover:bg-teal-50 hover:text-teal-700 transition-colors"
        >
            <span>Residential Hospital Stay</span>
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
        </a>
        <a 
            href="#matrix-gym" 
            class="mobile-nav-link flex items-center justify-between px-4 py-2.5 rounded-xl text-base font-semibold text-slate-800 hover:bg-teal-50 hover:text-teal-700 transition-colors"
        >
            <span>Matrix Physio Gym</span>
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
        </a>
        <a 
            href="#our-story" 
            class="mobile-nav-link flex items-center justify-between px-4 py-2.5 rounded-xl text-base font-semibold text-slate-800 hover:bg-teal-50 hover:text-teal-700 transition-colors"
        >
            <span>Our 5-Year Story</span>
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
        </a>
        <a 
            href="#care-team" 
            class="mobile-nav-link flex items-center justify-between px-4 py-2.5 rounded-xl text-base font-semibold text-slate-800 hover:bg-teal-50 hover:text-teal-700 transition-colors"
        >
            <span>Our Doctors</span>
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
        </a>
        <a 
            href="#patient-stories" 
            class="mobile-nav-link flex items-center justify-between px-4 py-2.5 rounded-xl text-base font-semibold text-slate-800 hover:bg-teal-50 hover:text-teal-700 transition-colors"
        >
            <span>Patient Reviews</span>
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
        </a>
        <a 
            href="#appointment" 
            class="mobile-nav-link flex items-center justify-between px-4 py-2.5 rounded-xl text-base font-semibold text-slate-800 hover:bg-teal-50 hover:text-teal-700 transition-colors"
        >
            <span>Contact & Location</span>
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
        </a>

        <div class="pt-3 mt-3 border-t border-slate-100 flex flex-col gap-2.5">
            <a 
                href="tel:9607378772" 
                class="flex items-center justify-center gap-2 py-3 rounded-xl border border-slate-200 text-sm font-bold text-slate-700 hover:bg-teal-50 hover:text-teal-700 transition-colors"
            >
                <svg class="w-4 h-4 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
                <span>Call Clinic: +91 96073 78772</span>
            </a>
            <a 
                href="#appointment" 
                class="mobile-nav-link flex items-center justify-center gap-2 py-3 rounded-xl bg-teal-600 text-white text-sm font-bold shadow-md shadow-teal-700/20 active:scale-[0.99] transition-transform"
            >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <span>Book An Appointment</span>
            </a>
        </div>
    </div>
</header>

<script>
    const header = document.getElementById('main-header');
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuOpenIcon = document.getElementById('menu-icon-open');
    const menuCloseIcon = document.getElementById('menu-icon-close');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    // Toggle Mobile Menu
    menuBtn?.addEventListener('click', () => {
        const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
        menuBtn.setAttribute('aria-expanded', (!isExpanded).toString());
        mobileMenu?.classList.toggle('hidden');
        menuOpenIcon?.classList.toggle('hidden');
        menuCloseIcon?.classList.toggle('hidden');
    });

    // Close mobile menu when clicking a link
    mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
            mobileMenu?.classList.add('hidden');
            menuOpenIcon?.classList.remove('hidden');
            menuCloseIcon?.classList.add('hidden');
            menuBtn?.setAttribute('aria-expanded', 'false');
        });
    });

    // Header scroll background elevation with requestAnimationFrame throttling
    let headerTicking = false;
    window.addEventListener('scroll', () => {
        if (!headerTicking) {
            window.requestAnimationFrame(() => {
                if (window.scrollY > 20) {
                    header?.classList.add('shadow-sm', 'bg-white/95');
                    header?.classList.remove('bg-white/85');
                } else {
                    header?.classList.remove('shadow-sm', 'bg-white/95');
                    header?.classList.add('bg-white/85');
                }
                headerTicking = false;
            });
            headerTicking = true;
        }
    }, { passive: true });
</script>

